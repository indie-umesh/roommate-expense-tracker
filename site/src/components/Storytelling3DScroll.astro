---
// Storytelling3DScroll.astro
// Real-Life 3D Scroll Storytelling Component for Roommate Expense Tracker
// Showcases a real month in Flat 302 with Amar, Akbar, and Anthony
import AnimatedFlatmates from './AnimatedFlatmates.astro';
import BrandLogo from './BrandLogo.astro';
---

<div class="relative w-full max-w-5xl mx-auto py-8 select-none" id="story-3d-root">
  <!-- Section Header -->
  <div class="text-center max-w-2xl mx-auto space-y-3 mb-10">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0066cc]/10 dark:bg-[#2997ff]/15 border border-[#0066cc]/20 dark:border-[#2997ff]/30 text-[12px] font-semibold text-[#0066cc] dark:text-[#2997ff]">
      <span>🎬 3D Interactive Story</span>
      <span class="w-1.5 h-1.5 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-ping"></span>
    </div>
    
    <h2 class="apple-display-lg text-[#1d1d1f] dark:text-white">
      A Month in Flat 302: How Shared Expenses Actually Happen
    </h2>
    <p class="text-[16px] sm:text-[17px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
      Three roommates, three different paydays. Watch how Roommate eliminates awkward money talks, spreadsheet chaos, and 6 messy bank transfers.
    </p>
  </div>

  <!-- Interactive Chapter Timeline Navigator -->
  <div class="flex items-center justify-center gap-2 sm:gap-3 mb-8 overflow-x-auto px-2 pb-2 scrollbar-none" id="story-chapter-nav">
    <button
      type="button"
      data-chapter="0"
      class="chapter-tab active px-4 py-2 rounded-full text-xs sm:text-[13px] font-medium transition cursor-pointer flex items-center gap-2 border bg-[#0066cc] text-white border-transparent shadow-sm"
    >
      <span class="font-bold">01</span>
      <span>1st: Rent Day</span>
    </button>

    <button
      type="button"
      data-chapter="1"
      class="chapter-tab px-4 py-2 rounded-full text-xs sm:text-[13px] font-medium transition cursor-pointer flex items-center gap-2 border bg-[#f5f5f7] dark:bg-[#1d1d1f] text-[#86868b] border-black/8 dark:border-white/10 hover:text-[#1d1d1f] dark:hover:text-white"
    >
      <span class="font-bold">02</span>
      <span>5th: Groceries & Swiggy</span>
    </button>

    <button
      type="button"
      data-chapter="2"
      class="chapter-tab px-4 py-2 rounded-full text-xs sm:text-[13px] font-medium transition cursor-pointer flex items-center gap-2 border bg-[#f5f5f7] dark:bg-[#1d1d1f] text-[#86868b] border-black/8 dark:border-white/10 hover:text-[#1d1d1f] dark:hover:text-white"
    >
      <span class="font-bold">03</span>
      <span>15th: The Payday Gap</span>
    </button>

    <button
      type="button"
      data-chapter="3"
      class="chapter-tab px-4 py-2 rounded-full text-xs sm:text-[13px] font-medium transition cursor-pointer flex items-center gap-2 border bg-[#f5f5f7] dark:bg-[#1d1d1f] text-[#86868b] border-black/8 dark:border-white/10 hover:text-[#1d1d1f] dark:hover:text-white"
    >
      <span class="font-bold">04</span>
      <span>30th: 1-Tap Settle</span>
    </button>
  </div>

  <!-- 3D STAGE WRAPPER -->
  <div class="relative w-full perspective-stage pb-6" id="stage-3d-container">
    
    <!-- 3D Scene Card (Hardware Chassis) -->
    <div
      id="card-3d-chassis"
      class="relative w-full rounded-[28px] sm:rounded-[36px] bg-white dark:bg-[#161617] border border-black/10 dark:border-white/10 shadow-2xl overflow-hidden transition-all duration-700 ease-out transform-gpu"
      style="transform-style: preserve-3d; transform: rotateX(8deg) rotateY(-8deg) scale(0.98);"
    >
      <!-- Specular Light Glare (Dynamic Glass Highlight) -->
      <div id="card-glare" class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/15 dark:via-white/5 to-transparent pointer-events-none transition-opacity duration-300 z-30"></div>

      <!-- Top Device Header / Group Title -->
      <div class="px-6 py-4 border-b border-black/6 dark:border-white/10 bg-[#f5f5f7]/70 dark:bg-[#1d1d1f]/70 backdrop-blur-md flex items-center justify-between">
        <div class="flex items-center gap-3">
          <BrandLogo size={24} />
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs sm:text-sm font-bold text-[#1d1d1f] dark:text-white">Flat 302 · Whitefield</span>
              <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-semibold">Live Ledger</span>
            </div>
            <p class="text-[11px] text-[#86868b]">Amar · Akbar · Anthony (3 members)</p>
          </div>
        </div>

        <!-- Date & Step Pill -->
        <div class="flex items-center gap-2">
          <span id="story-date-badge" class="px-3 py-1 rounded-full bg-white dark:bg-[#2c2c2e] border border-black/8 dark:border-white/10 text-xs font-semibold text-[#1d1d1f] dark:text-white shadow-xs">
            📅 Nov 1 (Day 1)
          </span>
        </div>
      </div>

      <!-- Main 3D Canvas Content Area -->
      <div class="p-6 sm:p-8 space-y-6">
        
        <!-- Chapter Description Banner -->
        <div class="rounded-2xl p-4 sm:p-5 bg-[#f5f5f7] dark:bg-[#1d1d1f] border border-black/6 dark:border-white/10 space-y-2">
          <div class="flex items-center justify-between">
            <span id="story-step-indicator" class="text-xs uppercase tracking-wider font-bold text-[#0066cc] dark:text-[#2997ff]">
              Chapter 01 of 04 · Rent Day
            </span>
            <span id="story-impact-badge" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">
              Zero Entry Friction
            </span>
          </div>
          <h3 id="story-headline" class="text-lg sm:text-xl font-bold text-[#1d1d1f] dark:text-white">
            Anthony's payday is the 1st. He pays ₹24,000 rent to landlord Sharma Uncle.
          </h3>
          <p id="story-narration" class="text-xs sm:text-sm text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
            Instead of nagging roommates or losing a paper receipt, Anthony logs it in 6 seconds. Roommate automatically splits ₹8,000 to each flatmate and credits Anthony ₹16,000 without demanding immediate transfer.
          </p>
        </div>

        <!-- 3D DYNAMIC FLOATING RECEIPT BADGE -->
        <div class="relative py-2 flex justify-center">
          <div
            id="floating-bill-badge"
            class="relative z-20 px-5 py-4 rounded-2xl bg-white/95 dark:bg-[#252527]/95 border border-black/10 dark:border-white/15 shadow-xl flex flex-wrap items-center justify-between gap-4 w-full max-w-lg transition-transform duration-500 ease-out"
            style="transform: translateZ(40px);"
          >
            <div class="flex items-center gap-3">
              <div id="bill-icon-bg" class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-900/60 flex items-center justify-center text-xl">
                🏠
              </div>
              <div>
                <h4 id="bill-title" class="text-xs sm:text-sm font-bold text-[#1d1d1f] dark:text-white">November Flat Rent</h4>
                <p id="bill-subtitle" class="text-[11px] text-[#86868b]">Paid by Anthony · Split Equally (3 ways)</p>
              </div>
            </div>

            <div class="text-right">
              <span id="bill-amount" class="text-base sm:text-lg font-bold text-[#1d1d1f] dark:text-white tracking-tight">₹24,000</span>
              <p id="bill-split-info" class="text-[10px] text-[#0066cc] dark:text-[#2997ff] font-semibold">₹8,000 / person</p>
            </div>
          </div>
        </div>

        <!-- THREE-WAY LIVE NET BALANCE LEDGER CARDS -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
          <!-- Amar's Card -->
          <div
            id="card-amar"
            class="p-4 rounded-2xl bg-[#fbfbfd] dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 transition-all duration-500 space-y-2 relative"
            style="transform: translateZ(20px);"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-full bg-[#0066cc]/15 text-[#0066cc] flex items-center justify-center font-bold text-xs">
                  A
                </div>
                <div>
                  <span class="text-xs font-bold text-[#1d1d1f] dark:text-white block">Amar</span>
                  <span class="text-[10px] text-[#86868b]">Payday: 15th</span>
                </div>
              </div>
              <span id="badge-amar-status" class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-500/10 text-rose-600 dark:text-rose-400">
                Owes
              </span>
            </div>
            <div class="pt-1 flex items-baseline justify-between border-t border-black/5 dark:border-white/5">
              <span class="text-[11px] text-[#86868b]">Net Balance</span>
              <span id="val-amar-balance" class="text-sm font-bold text-rose-600 dark:text-rose-400">-₹8,000</span>
            </div>
          </div>

          <!-- Akbar's Card -->
          <div
            id="card-akbar"
            class="p-4 rounded-2xl bg-[#fbfbfd] dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 transition-all duration-500 space-y-2 relative"
            style="transform: translateZ(20px);"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-full bg-emerald-500/15 text-emerald-600 flex items-center justify-center font-bold text-xs">
                  K
                </div>
                <div>
                  <span class="text-xs font-bold text-[#1d1d1f] dark:text-white block">Akbar</span>
                  <span class="text-[10px] text-[#86868b]">Payday: 5th</span>
                </div>
              </div>
              <span id="badge-akbar-status" class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-500/10 text-rose-600 dark:text-rose-400">
                Owes
              </span>
            </div>
            <div class="pt-1 flex items-baseline justify-between border-t border-black/5 dark:border-white/5">
              <span class="text-[11px] text-[#86868b]">Net Balance</span>
              <span id="val-akbar-balance" class="text-sm font-bold text-rose-600 dark:text-rose-400">-₹8,000</span>
            </div>
          </div>

          <!-- Anthony's Card -->
          <div
            id="card-anthony"
            class="p-4 rounded-2xl bg-[#fbfbfd] dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 transition-all duration-500 space-y-2 relative"
            style="transform: translateZ(20px);"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-full bg-amber-500/15 text-amber-600 flex items-center justify-center font-bold text-xs">
                  T
                </div>
                <div>
                  <span class="text-xs font-bold text-[#1d1d1f] dark:text-white block">Anthony</span>
                  <span class="text-[10px] text-[#86868b]">Payday: 1st</span>
                </div>
              </div>
              <span id="badge-anthony-status" class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                Owed
              </span>
            </div>
            <div class="pt-1 flex items-baseline justify-between border-t border-black/5 dark:border-white/5">
              <span class="text-[11px] text-[#86868b]">Net Balance</span>
              <span id="val-anthony-balance" class="text-sm font-bold text-emerald-600 dark:text-emerald-400">+₹16,000</span>
            </div>
          </div>
        </div>

        <!-- FLATMATES SPEECH & REACTION ROW -->
        <div class="p-4 rounded-2xl bg-[#f5f5f7]/60 dark:bg-[#1d1d1f]/60 border border-black/6 dark:border-white/8 flex flex-col sm:flex-row items-center gap-4">
          <div class="w-10 h-10 rounded-full bg-[#0066cc]/10 dark:bg-[#2997ff]/20 flex items-center justify-center text-xl shrink-0">
            💬
          </div>
          <div class="flex-1 text-center sm:text-left">
            <p id="story-quote-speaker" class="text-xs font-bold text-[#1d1d1f] dark:text-white">Anthony says:</p>
            <p id="story-quote-text" class="text-xs sm:text-[13px] text-[#86868b] dark:text-[#a1a1a6] italic">
              "Paid ₹24,000 directly via UPI to Sharma Uncle. Settle whenever your paydays come up this month!"
            </p>
          </div>
          <div class="shrink-0 flex items-center gap-1.5 px-3 py-1 rounded-full bg-white dark:bg-[#2c2c2e] border border-black/6 dark:border-white/10 text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-semibold">
            <span>∑ Balances = ₹0.00</span>
          </div>
        </div>

      </div>

      <!-- Bottom Interactive Controls & Next Step Button -->
      <div class="px-6 py-4 bg-[#f5f5f7]/90 dark:bg-[#1d1d1f]/90 border-t border-black/6 dark:border-white/10 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-story-prev"
            class="px-3 py-1.5 rounded-full text-xs font-semibold bg-white dark:bg-[#2c2c2e] text-[#1d1d1f] dark:text-white border border-black/8 dark:border-white/10 hover:bg-[#ebebee] dark:hover:bg-[#38383a] transition cursor-pointer disabled:opacity-40"
            disabled
          >
            ← Previous
          </button>
          <button
            type="button"
            id="btn-story-next"
            class="px-4 py-1.5 rounded-full text-xs font-semibold bg-[#0066cc] hover:bg-[#0071e3] text-white transition active:scale-95 cursor-pointer flex items-center gap-1.5"
          >
            <span>Next Chapter</span>
            <span>→</span>
          </button>
        </div>

        <!-- 3D Perspective Mode Indicator & Auto-Play -->
        <div class="flex items-center gap-3">
          <label class="flex items-center gap-1.5 text-xs text-[#86868b] cursor-pointer select-none">
            <input type="checkbox" id="check-story-autoplay" class="rounded text-[#0066cc]" checked />
            <span>Auto-advance (5s)</span>
          </label>

          <span class="hidden sm:inline text-[11px] text-[#86868b] font-mono">
            3D Tilt Enabled ✦
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .perspective-stage {
    perspective: 1200px;
    perspective-origin: center center;
  }
  
  .chapter-tab.active {
    background-color: #0066cc !important;
    color: #ffffff !important;
    border-color: transparent !important;
  }

  /* Smooth 3D animations */
  #card-3d-chassis {
    will-change: transform;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<script is:inline>
  (function() {
    const chapters = [
      {
        id: 0,
        date: "📅 Nov 1 (Day 1)",
        stepIndicator: "Chapter 01 of 04 · Rent Day",
        impact: "Zero Entry Friction",
        headline: "Anthony's payday is the 1st. He pays ₹24,000 rent to landlord Sharma Uncle.",
        narration: "Instead of nagging roommates or losing a paper receipt, Anthony logs it in 6 seconds. Roommate automatically splits ₹8,000 to each flatmate and credits Anthony ₹16,000 without demanding immediate transfer.",
        billIcon: "🏠",
        billTitle: "November Flat Rent",
        billSubtitle: "Paid by Anthony · Split Equally (3 ways)",
        billAmount: "₹24,000",
        billSplit: "₹8,000 / person",
        amar: { status: "Owes", class: "text-rose-600 dark:text-rose-400", val: "-₹8,000" },
        akbar: { status: "Owes", class: "text-rose-600 dark:text-rose-400", val: "-₹8,000" },
        anthony: { status: "Owed", class: "text-emerald-600 dark:text-emerald-400", val: "+₹16,000" },
        speaker: "Anthony says:",
        quote: "\"Paid ₹24,000 directly via UPI to Sharma Uncle. Settle whenever your paydays come up this month!\"",
        tilt: { x: 8, y: -8, scale: 0.98 }
      },
      {
        id: 1,
        date: "📅 Nov 5 (Day 5)",
        stepIndicator: "Chapter 02 of 04 · Groceries & Midnight Swiggy",
        impact: "Automatic Balance Offset",
        headline: "Akbar gets paid on the 5th and buys ₹4,500 groceries. Amar orders late-night Swiggy ₹1,200.",
        narration: "Akbar's grocery expense of ₹4,500 automatically cancels out part of what he owes Anthony. Amar adds a ₹1,200 Swiggy pizza order in 3 taps. Roommate updates the running ledger in real time with zero manual math.",
        billIcon: "🥦",
        billTitle: "Nature's Basket Groceries & Swiggy",
        billSubtitle: "Paid by Akbar (₹4,500) & Amar (₹1,200)",
        billAmount: "₹5,700 total",
        billSplit: "Auto-adjusted shares",
        amar: { status: "Owes", class: "text-rose-600 dark:text-rose-400", val: "-₹7,600" },
        akbar: { status: "Owes", class: "text-rose-600 dark:text-rose-400", val: "-₹6,500" },
        anthony: { status: "Owed", class: "text-emerald-600 dark:text-emerald-400", val: "+₹14,100" },
        speaker: "Akbar says:",
        quote: "\"Stocked veggies, paneer, and cooking oil. Roommate automatically credited ₹3,000 against my rent dues!\"",
        tilt: { x: 6, y: 8, scale: 0.99 }
      },
      {
        id: 2,
        date: "📅 Nov 15 (Day 15)",
        stepIndicator: "Chapter 03 of 04 · The Payday Gap Solved",
        impact: "Zero Awkward Arguments",
        headline: "Amar gets paid on the 15th (14 days after rent). Zero awkward follow-ups.",
        narration: "In standard flats, 14 days without settling causes tension and forgotten receipts. In Roommate, Amar opens the app and sees his exact net debt. Every bill is recorded with timestamps, category tags, and spreadsheet clarity.",
        billIcon: "📊",
        billTitle: "Running Ledger Transparency",
        billSubtitle: "Wi-Fi ₹1,500 + Maid ₹3,000 logged seamlessly",
        billAmount: "₹4,500 utilities",
        billSplit: "Zero forgotten bills",
        amar: { status: "Owes", class: "text-rose-600 dark:text-rose-400", val: "-₹7,600" },
        akbar: { status: "Owes", class: "text-rose-600 dark:text-rose-400", val: "-₹6,500" },
        anthony: { status: "Owed", class: "text-emerald-600 dark:text-emerald-400", val: "+₹14,100" },
        speaker: "Amar says:",
        quote: "\"My salary just credited! No awkward reminders needed—I can see the exact breakdown down to the single rupee.\"",
        tilt: { x: 0, y: 0, scale: 1.01 }
      },
      {
        id: 3,
        date: "📅 Nov 30 (Day 30)",
        stepIndicator: "Chapter 04 of 04 · Magic 1-Tap UPI Settlement",
        impact: "Greedy Debt Simplification",
        headline: "Month-End Settle Up: 12 mixed expenses reduced to just 2 direct UPI transfers!",
        narration: "Normally, 3 people with 12 split expenses would need 6 confusing transfers back and forth. Roommate's greedy debt graph simplifies it down to the mathematical minimum: Amar pays Anthony ₹7,600, Akbar pays Anthony ₹6,500. Settle done in 60 seconds!",
        billIcon: "⚡",
        billTitle: "Greedy Simplification: Minimum Transfers",
        billSubtitle: "2 UPI Payments: Amar → Anthony & Akbar → Anthony",
        billAmount: "All Settled ₹0.00",
        billSplit: "100% Math Guaranteed",
        amar: { status: "Settled", class: "text-emerald-600 dark:text-emerald-400 font-bold", val: "₹0.00 ✓" },
        akbar: { status: "Settled", class: "text-emerald-600 dark:text-emerald-400 font-bold", val: "₹0.00 ✓" },
        anthony: { status: "Settled", class: "text-emerald-600 dark:text-emerald-400 font-bold", val: "₹0.00 ✓" },
        speaker: "Anthony, Amar & Akbar celebrate:",
        quote: "\"All settled via PhonePe/GPay in under 1 minute. No pending debts, no awkwardness, ready for next month! 🎉\"",
        tilt: { x: -6, y: 6, scale: 1.02 }
      }
    ];

    let currentChapter = 0;
    let autoplayTimer = null;

    const navTabs = document.querySelectorAll('#story-chapter-nav .chapter-tab');
    const chassis = document.getElementById('card-3d-chassis');
    const glare = document.getElementById('card-glare');
    const prevBtn = document.getElementById('btn-story-prev');
    const nextBtn = document.getElementById('btn-story-next');
    const autoplayCheck = document.getElementById('check-story-autoplay');

    function applyChapter(idx) {
      if (idx < 0 || idx >= chapters.length) return;
      currentChapter = idx;
      const c = chapters[idx];

      // Update Nav Tabs
      navTabs.forEach((tab, i) => {
        if (i === idx) {
          tab.className = "chapter-tab active px-4 py-2 rounded-full text-xs sm:text-[13px] font-medium transition cursor-pointer flex items-center gap-2 border bg-[#0066cc] text-white border-transparent shadow-sm";
        } else {
          tab.className = "chapter-tab px-4 py-2 rounded-full text-xs sm:text-[13px] font-medium transition cursor-pointer flex items-center gap-2 border bg-[#f5f5f7] dark:bg-[#1d1d1f] text-[#86868b] border-black/8 dark:border-white/10 hover:text-[#1d1d1f] dark:hover:text-white";
        }
      });

      // Update Texts
      const dateEl = document.getElementById('story-date-badge');
      if (dateEl) dateEl.textContent = c.date;

      const stepInd = document.getElementById('story-step-indicator');
      if (stepInd) stepInd.textContent = c.stepIndicator;

      const impactEl = document.getElementById('story-impact-badge');
      if (impactEl) impactEl.textContent = c.impact;

      const headlineEl = document.getElementById('story-headline');
      if (headlineEl) headlineEl.textContent = c.headline;

      const narrEl = document.getElementById('story-narration');
      if (narrEl) narrEl.textContent = c.narration;

      // Update Bill Badge
      const iconEl = document.getElementById('bill-icon-bg');
      if (iconEl) iconEl.textContent = c.billIcon;

      const titleEl = document.getElementById('bill-title');
      if (titleEl) titleEl.textContent = c.billTitle;

      const subEl = document.getElementById('bill-subtitle');
      if (subEl) subEl.textContent = c.billSubtitle;

      const amtEl = document.getElementById('bill-amount');
      if (amtEl) amtEl.textContent = c.billAmount;

      const splitEl = document.getElementById('bill-split-info');
      if (splitEl) splitEl.textContent = c.billSplit;

      // Update Balances
      const valAmar = document.getElementById('val-amar-balance');
      const bAmar = document.getElementById('badge-amar-status');
      if (valAmar && bAmar) {
        valAmar.textContent = c.amar.val;
        valAmar.className = `text-sm font-bold ${c.amar.class}`;
        bAmar.textContent = c.amar.status;
        bAmar.className = `px-2 py-0.5 rounded-full text-[10px] font-semibold ${c.amar.status === 'Settled' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-rose-500/10 text-rose-600 dark:text-rose-400'}`;
      }

      const valAkbar = document.getElementById('val-akbar-balance');
      const bAkbar = document.getElementById('badge-akbar-status');
      if (valAkbar && bAkbar) {
        valAkbar.textContent = c.akbar.val;
        valAkbar.className = `text-sm font-bold ${c.akbar.class}`;
        bAkbar.textContent = c.akbar.status;
        bAkbar.className = `px-2 py-0.5 rounded-full text-[10px] font-semibold ${c.akbar.status === 'Settled' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-rose-500/10 text-rose-600 dark:text-rose-400'}`;
      }

      const valAnthony = document.getElementById('val-anthony-balance');
      const bAnthony = document.getElementById('badge-anthony-status');
      if (valAnthony && bAnthony) {
        valAnthony.textContent = c.anthony.val;
        valAnthony.className = `text-sm font-bold ${c.anthony.class}`;
        bAnthony.textContent = c.anthony.status;
        bAnthony.className = `px-2 py-0.5 rounded-full text-[10px] font-semibold ${c.anthony.status === 'Settled' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400'}`;
      }

      // Update Quotes
      const speakerEl = document.getElementById('story-quote-speaker');
      if (speakerEl) speakerEl.textContent = c.speaker;

      const quoteEl = document.getElementById('story-quote-text');
      if (quoteEl) quoteEl.textContent = c.quote;

      // Update 3D Chassis Transform
      if (chassis) {
        chassis.style.transform = `rotateX(${c.tilt.x}deg) rotateY(${c.tilt.y}deg) scale(${c.tilt.scale})`;
      }

      // Update Prev / Next buttons
      if (prevBtn) prevBtn.disabled = idx === 0;
      if (nextBtn) {
        if (idx === chapters.length - 1) {
          nextBtn.innerHTML = "<span>Restart Story ↺</span>";
        } else {
          nextBtn.innerHTML = "<span>Next Chapter →</span>";
        }
      }
    }

    // Attach Nav Clicks
    navTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = parseInt(tab.getAttribute('data-chapter') || '0', 10);
        applyChapter(id);
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentChapter > 0) applyChapter(currentChapter - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        if (currentChapter < chapters.length - 1) {
          applyChapter(currentChapter + 1);
        } else {
          applyChapter(0);
        }
      });
    }

    // Auto-Play
    function resetAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
      if (autoplayCheck && autoplayCheck.checked) {
        autoplayTimer = setInterval(() => {
          if (currentChapter < chapters.length - 1) {
            applyChapter(currentChapter + 1);
          } else {
            applyChapter(0);
          }
        }, 5500);
      }
    }

    if (autoplayCheck) {
      autoplayCheck.addEventListener('change', resetAutoplay);
    }
    resetAutoplay();

    // Mouse-Interactive 3D Parallax Tilt (Desktop)
    const stageContainer = document.getElementById('stage-3d-container');
    if (stageContainer && window.matchMedia('(pointer: fine)').matches) {
      stageContainer.addEventListener('mousemove', (e) => {
        const rect = stageContainer.getBoundingClientRect();
        const mouseX = (e.clientX - rect.left) / rect.width - 0.5;
        const mouseY = (e.clientY - rect.top) / rect.height - 0.5;

        const baseTilt = chapters[currentChapter].tilt;
        const tiltX = baseTilt.x - mouseY * 14;
        const tiltY = baseTilt.y + mouseX * 16;

        if (chassis) {
          chassis.style.transform = `rotateX(${tiltX.toFixed(2)}deg) rotateY(${tiltY.toFixed(2)}deg) scale(${baseTilt.scale})`;
        }

        if (glare) {
          glare.style.opacity = Math.min(0.35, Math.max(0.05, 0.15 + mouseY * 0.2)).toString();
        }
      });

      stageContainer.addEventListener('mouseleave', () => {
        const baseTilt = chapters[currentChapter].tilt;
        if (chassis) {
          chassis.style.transform = `rotateX(${baseTilt.x}deg) rotateY(${baseTilt.y}deg) scale(${baseTilt.scale})`;
        }
        if (glare) glare.style.opacity = '0.15';
      });
    }

    // High-class Scroll Observer: As the user scrolls into the section, trigger 3D reveal
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            applyChapter(currentChapter);
          }
        });
      }, { threshold: 0.2 });

      const root = document.getElementById('story-3d-root');
      if (root) observer.observe(root);
    }
  })();
</script>

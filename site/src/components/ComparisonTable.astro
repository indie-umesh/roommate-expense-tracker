---
// Competitor Comparison Table Component (Roommate vs Splitwise vs Google Sheets vs Tricount)
interface Props {
  highlightCompetitor?: 'splitwise' | 'sheets' | 'tricount' | 'all';
}

const { highlightCompetitor = 'all' } = Astro.props;
---

<div class="overflow-x-auto rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 backdrop-blur-xl shadow-xl transition-colors duration-200">
  <table class="w-full text-left border-collapse text-xs sm:text-sm">
    <thead>
      <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-700 dark:text-slate-300">
        <th class="p-4 sm:p-5 font-bold uppercase tracking-wider text-xs">Feature / Capability</th>
        <th class="p-4 sm:p-5 bg-indigo-50/80 dark:bg-indigo-950/60 border-x border-indigo-200 dark:border-indigo-500/30 text-indigo-950 dark:text-white font-extrabold text-sm sm:text-base">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
            <span>Roommate (Ours)</span>
          </div>
          <span class="block text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 mt-0.5">100% Free Forever</span>
        </th>
        <th class="p-4 sm:p-5 font-bold">
          Splitwise (Free Plan)
          <span class="block text-[11px] font-normal text-rose-500 dark:text-rose-400 mt-0.5">Restricted & Monetized</span>
        </th>
        <th class="p-4 sm:p-5 font-bold">
          Google Sheets
          <span class="block text-[11px] font-normal text-amber-600 dark:text-amber-400 mt-0.5">High Entry Friction</span>
        </th>
        <th class="p-4 sm:p-5 font-bold">
          Tricount / Settle Up
          <span class="block text-[11px] font-normal text-slate-500 dark:text-slate-400 mt-0.5">Ad-heavy & Complex</span>
        </th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
      <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30">
        <td class="p-4 sm:p-5 font-semibold text-slate-900 dark:text-white">Daily Expense Limit</td>
        <td class="p-4 sm:p-5 bg-indigo-50/40 dark:bg-indigo-950/30 border-x border-indigo-200 dark:border-indigo-500/30 font-bold text-emerald-600 dark:text-emerald-400">
          ✓ Unlimited Expenses Always
        </td>
        <td class="p-4 sm:p-5 text-rose-600 dark:text-rose-400 font-medium">
          ❌ Capped at 3 expenses/day (blocks you!)
        </td>
        <td class="p-4 sm:p-5">Unlimited</td>
        <td class="p-4 sm:p-5">Unlimited</td>
      </tr>

      <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30">
        <td class="p-4 sm:p-5 font-semibold text-slate-900 dark:text-white">Annoying Wait Timers</td>
        <td class="p-4 sm:p-5 bg-indigo-50/40 dark:bg-indigo-950/30 border-x border-indigo-200 dark:border-indigo-500/30 font-bold text-emerald-600 dark:text-emerald-400">
          ✓ 0s Instant Entry
        </td>
        <td class="p-4 sm:p-5 text-rose-600 dark:text-rose-400 font-medium">
          ❌ 10-second countdown wait timer
        </td>
        <td class="p-4 sm:p-5">Instant</td>
        <td class="p-4 sm:p-5 text-rose-600 dark:text-rose-400">Frequent Delay Screens</td>
      </tr>

      <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30">
        <td class="p-4 sm:p-5 font-semibold text-slate-900 dark:text-white">Speed of Adding an Expense</td>
        <td class="p-4 sm:p-5 bg-indigo-50/40 dark:bg-indigo-950/30 border-x border-indigo-200 dark:border-indigo-500/30 font-bold text-emerald-600 dark:text-emerald-400">
          ⚡ ≤ 3 taps (&lt; 10 seconds on mobile)
        </td>
        <td class="p-4 sm:p-5 text-slate-500 dark:text-slate-400">Slow (Multi-step popups & upsells)</td>
        <td class="p-4 sm:p-5 text-rose-600 dark:text-rose-400">Very Slow (Typing in cells on mobile)</td>
        <td class="p-4 sm:p-5 text-slate-500 dark:text-slate-400">Average (6-8 taps)</td>
      </tr>

      <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30">
        <td class="p-4 sm:p-5 font-semibold text-slate-900 dark:text-white">Built-in Excel Matrix View</td>
        <td class="p-4 sm:p-5 bg-indigo-50/40 dark:bg-indigo-950/30 border-x border-indigo-200 dark:border-indigo-500/30 font-bold text-emerald-600 dark:text-emerald-400">
          ✓ Real-time spreadsheet tab + .xlsx export
        </td>
        <td class="p-4 sm:p-5 text-rose-600 dark:text-rose-400">
          ❌ Paywalled under Splitwise Pro ($39.99/yr)
        </td>
        <td class="p-4 sm:p-5">Yes (Manual formulas)</td>
        <td class="p-4 sm:p-5 text-rose-600 dark:text-rose-400">❌ Basic list only</td>
      </tr>

      <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30">
        <td class="p-4 sm:p-5 font-semibold text-slate-900 dark:text-white">Roommate Sign-in Friction</td>
        <td class="p-4 sm:p-5 bg-indigo-50/40 dark:bg-indigo-950/30 border-x border-indigo-200 dark:border-indigo-500/30 font-bold text-emerald-600 dark:text-emerald-400">
          ✓ Mobile Number + 6-digit PIN (No OTP wait)
        </td>
        <td class="p-4 sm:p-5 text-slate-500 dark:text-slate-400">Email verify + Password + Captcha</td>
        <td class="p-4 sm:p-5 text-slate-500 dark:text-slate-400">Google Account mandatory</td>
        <td class="p-4 sm:p-5 text-slate-500 dark:text-slate-400">Email login required</td>
      </tr>

      <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30">
        <td class="p-4 sm:p-5 font-semibold text-slate-900 dark:text-white">Handles Staggered Paydays (1st, 5th, 15th)</td>
        <td class="p-4 sm:p-5 bg-indigo-50/40 dark:bg-indigo-950/30 border-x border-indigo-200 dark:border-indigo-500/30 font-bold text-emerald-600 dark:text-emerald-400">
          ✓ Built specifically for payday cycles
        </td>
        <td class="p-4 sm:p-5 text-rose-600 dark:text-rose-400">❌ Confusing cumulative dues</td>
        <td class="p-4 sm:p-5 text-rose-600 dark:text-rose-400">❌ Breaks formula logic</td>
        <td class="p-4 sm:p-5 text-rose-600 dark:text-rose-400">❌ Not supported</td>
      </tr>

      <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30">
        <td class="p-4 sm:p-5 font-semibold text-slate-900 dark:text-white">Offline & Installable PWA</td>
        <td class="p-4 sm:p-5 bg-indigo-50/40 dark:bg-indigo-950/30 border-x border-indigo-200 dark:border-indigo-500/30 font-bold text-emerald-600 dark:text-emerald-400">
          ✓ Native feel, 0MB app store bloat
        </td>
        <td class="p-4 sm:p-5 text-slate-500 dark:text-slate-400">Requires Heavy App Store Download</td>
        <td class="p-4 sm:p-5 text-slate-500 dark:text-slate-400">Heavy Google Sheets app</td>
        <td class="p-4 sm:p-5 text-slate-500 dark:text-slate-400">App store download</td>
      </tr>
    </tbody>
  </table>
</div>

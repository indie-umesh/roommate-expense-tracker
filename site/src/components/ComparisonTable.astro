---
// Competitor Comparison Table Component (Roommate vs Splitwise vs Google Sheets)
// 100% Fully visible on mobile without horizontal scroll
interface Props {
  highlightCompetitor?: 'splitwise' | 'sheets' | 'all';
}

const { highlightCompetitor = 'all' } = Astro.props;
---

<div class="w-full overflow-hidden rounded-2xl sm:rounded-3xl border border-black/8 dark:border-white/10 bg-white dark:bg-[#161617] shadow-lg transition-colors duration-200">
  <table class="w-full table-fixed text-left border-collapse text-[10px] sm:text-xs md:text-sm">
    <thead>
      <tr class="border-b border-black/8 dark:border-white/10 bg-[#f5f5f7] dark:bg-[#1d1d1f] text-[#1d1d1f] dark:text-white">
        <th class="w-[28%] sm:w-[26%] p-1.5 sm:p-4 font-bold uppercase tracking-wider text-[9px] sm:text-xs">
          Capability
        </th>
        
        <th class="w-[30%] sm:w-[28%] p-1.5 sm:p-4 bg-[#00966d]/10 dark:bg-[#00966d]/20 border-x border-[#00966d]/25 text-[#00966d] dark:text-[#00e599] font-extrabold">
          <div class="flex items-center gap-1 sm:gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="truncate">Roommate</span>
          </div>
          <span class="block text-[8px] sm:text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 mt-0.5 whitespace-nowrap">
            100% Free
          </span>
        </th>

        <th class="w-[22%] sm:w-[23%] p-1.5 sm:p-4 font-bold text-[#1d1d1f] dark:text-white">
          <span class="block truncate">Splitwise</span>
          <span class="block text-[8px] sm:text-[11px] font-normal text-rose-500 dark:text-rose-400 mt-0.5 truncate">
            Restricted
          </span>
        </th>

        <th class="w-[20%] sm:w-[23%] p-1.5 sm:p-4 font-bold text-[#1d1d1f] dark:text-white">
          <span class="block truncate">Sheets</span>
          <span class="block text-[8px] sm:text-[11px] font-normal text-amber-600 dark:text-amber-400 mt-0.5 truncate">
            Manual
          </span>
        </th>
      </tr>
    </thead>

    <tbody class="divide-y divide-black/5 dark:divide-white/5 text-[#1d1d1f] dark:text-[#f5f5f7]">
      <tr class="hover:bg-black/[0.02] dark:hover:bg-white/[0.02]">
        <td class="p-1.5 sm:p-4 font-semibold text-[#1d1d1f] dark:text-white leading-tight">Daily Limit</td>
        <td class="p-1.5 sm:p-4 bg-[#00966d]/5 dark:bg-[#00966d]/10 border-x border-[#00966d]/15 font-bold text-emerald-600 dark:text-emerald-400 leading-tight">
          ✓ Unlimited Always
        </td>
        <td class="p-1.5 sm:p-4 text-rose-600 dark:text-rose-400 font-medium leading-tight">
          ❌ 3 bills/day cap
        </td>
        <td class="p-1.5 sm:p-4 text-[#86868b] dark:text-[#a1a1a6] leading-tight">Unlimited</td>
      </tr>

      <tr class="hover:bg-black/[0.02] dark:hover:bg-white/[0.02]">
        <td class="p-1.5 sm:p-4 font-semibold text-[#1d1d1f] dark:text-white leading-tight">Wait Timers</td>
        <td class="p-1.5 sm:p-4 bg-[#00966d]/5 dark:bg-[#00966d]/10 border-x border-[#00966d]/15 font-bold text-emerald-600 dark:text-emerald-400 leading-tight">
          ✓ 0s Instant
        </td>
        <td class="p-1.5 sm:p-4 text-rose-600 dark:text-rose-400 font-medium leading-tight">
          ❌ 10s wait timer
        </td>
        <td class="p-1.5 sm:p-4 text-[#86868b] dark:text-[#a1a1a6] leading-tight">0s</td>
      </tr>

      <tr class="hover:bg-black/[0.02] dark:hover:bg-white/[0.02]">
        <td class="p-1.5 sm:p-4 font-semibold text-[#1d1d1f] dark:text-white leading-tight">Entry Speed</td>
        <td class="p-1.5 sm:p-4 bg-[#00966d]/5 dark:bg-[#00966d]/10 border-x border-[#00966d]/15 font-bold text-emerald-600 dark:text-emerald-400 leading-tight">
          ⚡ ≤ 3 taps (&lt;10s)
        </td>
        <td class="p-1.5 sm:p-4 text-[#86868b] dark:text-[#a1a1a6] leading-tight">Slow (popups)</td>
        <td class="p-1.5 sm:p-4 text-rose-600 dark:text-rose-400 leading-tight">Very Slow (cells)</td>
      </tr>

      <tr class="hover:bg-black/[0.02] dark:hover:bg-white/[0.02]">
        <td class="p-1.5 sm:p-4 font-semibold text-[#1d1d1f] dark:text-white leading-tight">Excel Matrix</td>
        <td class="p-1.5 sm:p-4 bg-[#00966d]/5 dark:bg-[#00966d]/10 border-x border-[#00966d]/15 font-bold text-emerald-600 dark:text-emerald-400 leading-tight">
          ✓ Built-in + .xlsx
        </td>
        <td class="p-1.5 sm:p-4 text-rose-600 dark:text-rose-400 leading-tight">
          ❌ $39.99/yr Pro
        </td>
        <td class="p-1.5 sm:p-4 text-[#86868b] dark:text-[#a1a1a6] leading-tight">Manual formulas</td>
      </tr>

      <tr class="hover:bg-black/[0.02] dark:hover:bg-white/[0.02]">
        <td class="p-1.5 sm:p-4 font-semibold text-[#1d1d1f] dark:text-white leading-tight">Login Friction</td>
        <td class="p-1.5 sm:p-4 bg-[#00966d]/5 dark:bg-[#00966d]/10 border-x border-[#00966d]/15 font-bold text-emerald-600 dark:text-emerald-400 leading-tight">
          ✓ Phone + 6-PIN
        </td>
        <td class="p-1.5 sm:p-4 text-[#86868b] dark:text-[#a1a1a6] leading-tight">Email + Password</td>
        <td class="p-1.5 sm:p-4 text-[#86868b] dark:text-[#a1a1a6] leading-tight">Google Login</td>
      </tr>

      <tr class="hover:bg-black/[0.02] dark:hover:bg-white/[0.02]">
        <td class="p-1.5 sm:p-4 font-semibold text-[#1d1d1f] dark:text-white leading-tight">Paydays Cycle</td>
        <td class="p-1.5 sm:p-4 bg-[#00966d]/5 dark:bg-[#00966d]/10 border-x border-[#00966d]/15 font-bold text-emerald-600 dark:text-emerald-400 leading-tight">
          ✓ Auto Ledger
        </td>
        <td class="p-1.5 sm:p-4 text-rose-600 dark:text-rose-400 leading-tight">❌ Confusing dues</td>
        <td class="p-1.5 sm:p-4 text-rose-600 dark:text-rose-400 leading-tight">❌ Breaks formulas</td>
      </tr>
    </tbody>
  </table>
</div>

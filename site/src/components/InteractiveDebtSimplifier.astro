---
import AnimatedFlatmates from './AnimatedFlatmates.astro';
---

<div class="rounded-[24px] sm:rounded-[28px] p-4 sm:p-10 border border-black/8 dark:border-white/10 bg-white dark:bg-[#1d1d1f] apple-product-shadow relative overflow-hidden transition-colors duration-200 apple-reveal">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-0 right-0 w-80 h-80 bg-[#00966d]/5 dark:bg-[#00966d]/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 space-y-8">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-black/5 dark:border-white/10 pb-6">
      <div>
        <span class="inline-block text-[12px] font-semibold tracking-tight text-[#00966d] dark:text-[#00e599] uppercase tracking-wider mb-1.5">
          Live Algorithm Demonstration
        </span>
        <h3 class="apple-display-lg text-[#1d1d1f] dark:text-white">
          Greedy Debt Simplification in Action
        </h3>
        <p class="text-[15px] sm:text-[16px] text-[#86868b] dark:text-[#a1a1a6] mt-1 max-w-xl">
          Without debt simplification, 3 flatmates end up doing 6 confusing cross-transfers. Roommate minimizes it to just 2 direct settlements.
        </p>
      </div>

      <div class="shrink-0 flex items-center">
        <span class="px-4 py-1.5 rounded-full text-[12px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
          Math Invariant: Sum of Balances = ₹0
        </span>
      </div>
    </div>

    <!-- Animated Characters Trio Showcase -->
    <div class="pt-2 pb-4">
      <AnimatedFlatmates character="trio" showSpeech={true} />
    </div>

    <!-- The Solution Comparison -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
      <!-- Old Manual Way -->
      <div class="p-6 rounded-[20px] bg-[#fbfbfd] dark:bg-[#161617] border border-rose-500/20 space-y-3 apple-card-interactive">
        <div class="flex items-center gap-2 text-rose-600 dark:text-rose-400 text-[13px] font-semibold">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
          <span>Old Manual Way (6 Confusing Transfers)</span>
        </div>
        <p class="text-[14px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
          Akbar sends ₹5,000 to Amar, Amar sends ₹500 to Akbar, Anthony calculates 3 separate shares, someone forgets their UPI PIN, and flat group chats blow up with arguments.
        </p>
      </div>

      <!-- Roommate Way -->
      <div class="p-6 rounded-[20px] bg-[#fbfbfd] dark:bg-[#161617] border border-emerald-500/30 space-y-3 apple-card-interactive">
        <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 text-[13px] font-semibold">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          <span>Roommate Greedy Algorithm (2 Direct UPIs)</span>
        </div>
        <div class="space-y-2 text-[14px]">
          <div class="flex items-center justify-between bg-white dark:bg-[#1d1d1f] p-3 rounded-xl border border-black/5 dark:border-white/10 shadow-xs">
            <span>👉 <strong>Anthony</strong> pays <strong>Amar</strong></span>
            <span class="font-semibold text-emerald-600 dark:text-emerald-400">₹6,000 via UPI</span>
          </div>
          <div class="flex items-center justify-between bg-white dark:bg-[#1d1d1f] p-3 rounded-xl border border-black/5 dark:border-white/10 shadow-xs">
            <span>👉 <strong>Akbar</strong> pays <strong>Amar</strong></span>
            <span class="font-semibold text-emerald-600 dark:text-emerald-400">₹4,000 via UPI</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

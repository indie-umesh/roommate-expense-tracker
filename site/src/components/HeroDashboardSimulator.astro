<script is:inline>
  (function () {
    const desktopBtn = document.getElementById("btn-device-desktop");
    const mobileBtn = document.getElementById("btn-device-mobile");
    const frameDesktop = document.getElementById("frame-desktop");
    const frameMobile = document.getElementById("frame-mobile");

    const simStepLabel = document.getElementById("sim-step-label");
    const simToggleBtn = document.getElementById("btn-sim-toggle");
    const simPlayIcon = document.getElementById("sim-play-icon");
    const simPlayText = document.getElementById("sim-play-text");

    // Desktop elements
    const desktopTabBtns = document.querySelectorAll(".sim-tab-btn");
    const desktopTabViews = document.querySelectorAll(".desktop-tab-view");
    const desktopNewRow = document.getElementById("desktop-new-expense-row");
    const desktopNetBalance = document.getElementById("desktop-net-balance");
    const desktopAkbarDues = document.getElementById("desktop-akbar-dues");
    const desktopAnthonyDues = document.getElementById("desktop-anthony-dues");
    const desktopSheetNewRow = document.getElementById("desktop-sheet-new-row");
    const desktopMatrixAmar = document.getElementById("desktop-matrix-amar");
    const desktopMatrixAkbar = document.getElementById("desktop-matrix-akbar");
    const desktopMatrixAnthony = document.getElementById("desktop-matrix-anthony");

    // Mobile elements
    const mobileTabBtns = document.querySelectorAll(".mobile-tab-btn");
    const mobileTabViews = document.querySelectorAll(".mobile-tab-view");
    const mobileModal = document.getElementById("mobile-modal-add");
    const mobileInputAmt = document.getElementById("mobile-input-amount");
    const mobileInputDet = document.getElementById("mobile-input-details");
    const mobileBtnSave = document.getElementById("mobile-btn-save");
    const mobileNewRow = document.getElementById("mobile-new-expense-row");
    const mobileNetBalance = document.getElementById("mobile-net-balance");
    const mobileAkbarDues = document.getElementById("mobile-akbar-dues");
    const mobileAnthonyDues = document.getElementById("mobile-anthony-dues");
    const mobileSheetNewRow = document.getElementById("mobile-sheet-new-row");

    let isMobile = false;
    let isPaused = false;
    let stepIndex = 0;
    let timerId = null;

    // Switch Device Frames
    function setDevice(mobileMode) {
      isMobile = mobileMode;
      if (mobileMode) {
        desktopBtn.className = "flex-1 sm:flex-none flex items-center justify-center gap-2 px-3.5 sm:px-4 py-1.5 rounded-xl text-xs font-semibold transition cursor-pointer text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white";
        mobileBtn.className = "flex-1 sm:flex-none flex items-center justify-center gap-2 px-3.5 sm:px-4 py-1.5 rounded-xl text-xs font-semibold transition cursor-pointer bg-[#00966d] text-white shadow-sm";
        frameDesktop.classList.add("hidden");
        frameMobile.classList.remove("hidden");
      } else {
        desktopBtn.className = "flex-1 sm:flex-none flex items-center justify-center gap-2 px-3.5 sm:px-4 py-1.5 rounded-xl text-xs font-semibold transition cursor-pointer bg-[#00966d] text-white shadow-sm";
        mobileBtn.className = "flex-1 sm:flex-none flex items-center justify-center gap-2 px-3.5 sm:px-4 py-1.5 rounded-xl text-xs font-semibold transition cursor-pointer text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white";
        frameDesktop.classList.remove("hidden");
        frameMobile.classList.add("hidden");
      }
    }

    // Auto-detect mobile screen on load
    const isSmallScreen = window.innerWidth < 768;
    setDevice(isSmallScreen);

    desktopBtn?.addEventListener("click", () => setDevice(false));
    mobileBtn?.addEventListener("click", () => setDevice(true));

    // Desktop Tab Switching
    function switchDesktopTab(tab) {
      desktopTabBtns.forEach((btn) => {
        if (btn.dataset.tab === tab) {
          btn.className = "sim-tab-btn px-3 py-1.5 rounded-lg bg-[#00966d] text-white shadow-xs transition";
        } else {
          btn.className = "sim-tab-btn px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition";
        }
      });
      desktopTabViews.forEach((v) => {
        v.classList.toggle("hidden", v.id !== `desktop-view-${tab}`);
      });
    }

    // Mobile Tab Switching
    function switchMobileTab(tab) {
      mobileTabBtns.forEach((btn) => {
        if (btn.dataset.tab === tab) {
          btn.className = "mobile-tab-btn flex flex-col items-center gap-0.5 text-[#00966d] dark:text-[#00e599] font-bold text-[10px] cursor-pointer";
        } else {
          btn.className = "mobile-tab-btn flex flex-col items-center gap-0.5 text-slate-500 dark:text-slate-400 font-medium text-[10px] cursor-pointer";
        }
      });
      mobileTabViews.forEach((v) => {
        v.classList.toggle("hidden", v.id !== `mobile-view-${tab}`);
      });
    }

    function switchAllTabs(tab) {
      switchDesktopTab(tab);
      switchMobileTab(tab);
    }

    desktopTabBtns.forEach((b) => b.addEventListener("click", () => {
      isPaused = true;
      updatePauseUI();
      switchAllTabs(b.dataset.tab);
    }));

    mobileTabBtns.forEach((b) => b.addEventListener("click", () => {
      isPaused = true;
      updatePauseUI();
      switchAllTabs(b.dataset.tab);
    }));

    // Pause UI
    function updatePauseUI() {
      if (isPaused) {
        simPlayIcon.textContent = "▶";
        simPlayText.textContent = "Resume Demo";
      } else {
        simPlayIcon.textContent = "⏸";
        simPlayText.textContent = "Pause Demo";
      }
    }

    simToggleBtn?.addEventListener("click", () => {
      isPaused = !isPaused;
      updatePauseUI();
    });

    document.getElementById("btn-desktop-add")?.addEventListener("click", triggerAddSimulation);
    document.getElementById("btn-mobile-add")?.addEventListener("click", triggerAddSimulation);

    // Simulated 3-Tap Add Expense
    function triggerAddSimulation() {
      switchAllTabs("overview");
      mobileModal.classList.remove("hidden");
      mobileInputAmt.value = "";
      mobileInputDet.value = "";

      let amt = "1200";
      let det = "Swiggy Dinner 🍕";
      let i = 0;

      const tAmt = setInterval(() => {
        if (i < amt.length) {
          mobileInputAmt.value += amt[i];
          i++;
        } else {
          clearInterval(tAmt);
          let j = 0;
          const tDet = setInterval(() => {
            if (j < det.length) {
              mobileInputDet.value += det[j];
              j++;
            } else {
              clearInterval(tDet);
              setTimeout(() => {
                mobileBtnSave.classList.add("scale-95");
                setTimeout(() => {
                  mobileBtnSave.classList.remove("scale-95");
                  mobileModal.classList.add("hidden");

                  // Update Desktop View
                  desktopNewRow?.classList.remove("hidden");
                  desktopNetBalance.textContent = "+₹10,800";
                  desktopAkbarDues.textContent = "₹4,400";
                  desktopAnthonyDues.textContent = "₹6,400";
                  desktopSheetNewRow?.classList.remove("hidden");
                  desktopMatrixAmar.textContent = "+₹10,800";
                  desktopMatrixAkbar.textContent = "-₹4,400";
                  desktopMatrixAnthony.textContent = "-₹6,400";

                  // Update Mobile View
                  mobileNewRow?.classList.remove("hidden");
                  mobileNetBalance.textContent = "+₹10,800";
                  mobileAkbarDues.textContent = "₹4,400";
                  mobileAnthonyDues.textContent = "₹6,400";
                  mobileSheetNewRow?.classList.remove("hidden");
                }, 300);
              }, 500);
            }
          }, 35);
        }
      }, 70);
    }

    function runNextStep() {
      if (isPaused) return;
      stepIndex = (stepIndex + 1) % 4;

      if (stepIndex === 0) {
        simStepLabel.textContent = "Step 1: 3-Tap Entry (<10s)";
        triggerAddSimulation();
      } else if (stepIndex === 1) {
        simStepLabel.textContent = "Step 2: Auto Balance (+₹10,800)";
        switchAllTabs("overview");
      } else if (stepIndex === 2) {
        simStepLabel.textContent = "Step 3: Excel Matrix View";
        switchAllTabs("sheet");
      } else if (stepIndex === 3) {
        simStepLabel.textContent = "Step 4: Greedy Settlement (2 UPIs)";
        switchAllTabs("settle");
      }
    }

    timerId = setInterval(runNextStep, 4500);
    setTimeout(runNextStep, 800);
  })();
</script>

---
// Ultra-realistic, auto-animated and interactive Dashboard UI Simulator
// Features authentic iPhone chassis with Dynamic Island and BottomNav, and desktop browser frame
import BrandLogo from './BrandLogo.astro';
---

<div class="w-full max-w-5xl mx-auto space-y-4" id="dashboard-simulator-root">
  <!-- Top Control Bar: Device Switcher, Theme Status & Auto-Play Controls -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-3 px-2 sm:px-4">
    <!-- Device Mode Switcher (Centered on mobile) -->
    <div class="flex items-center justify-center gap-1 p-1 bg-[#f5f5f7] dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 rounded-2xl shadow-xs w-full sm:w-auto">
      <button
        type="button"
        id="btn-device-desktop"
        class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-3.5 sm:px-4 py-1.5 rounded-xl text-xs font-semibold transition cursor-pointer bg-[#00966d] text-white"
        aria-label="Desktop Browser View"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>Desktop View</span>
      </button>

      <button
        type="button"
        id="btn-device-mobile"
        class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-3.5 sm:px-4 py-1.5 rounded-xl text-xs font-semibold transition cursor-pointer text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white"
        aria-label="Mobile Phone View"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        <span>Mobile Phone</span>
      </button>
    </div>

    <!-- Live Step Status & Auto-Play Controls (Fixed width prevents UI jitter on step change) -->
    <div class="flex items-center justify-between sm:justify-center gap-2 text-xs w-full sm:w-auto">
      <div class="flex-1 sm:w-[280px] sm:shrink-0 flex items-center gap-2 bg-[#f5f5f7] dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 px-3 py-1.5 rounded-xl text-[#1d1d1f] dark:text-white shadow-xs overflow-hidden min-w-0">
        <span class="w-2 h-2 rounded-full bg-[#00966d] dark:bg-[#00e599] shrink-0 animate-ping"></span>
        <span id="sim-step-label" class="font-semibold text-[11px] sm:text-xs truncate block">Step 1: 3-Tap Entry (&lt;10s)</span>
      </div>

      <button
        type="button"
        id="btn-sim-toggle"
        class="w-[105px] sm:w-[115px] shrink-0 flex items-center justify-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xl bg-[#f5f5f7] hover:bg-[#ebebee] dark:bg-[#1d1d1f] dark:hover:bg-[#28282b] text-[#1d1d1f] dark:text-white border border-black/8 dark:border-white/10 font-semibold cursor-pointer transition active:scale-95 shadow-xs text-[11px] sm:text-xs whitespace-nowrap"
      >
        <span id="sim-play-icon">⏸</span>
        <span id="sim-play-text">Pause Demo</span>
      </button>
    </div>
  </div>

  <!-- MAIN SIMULATOR CONTAINER -->
  <div class="relative transition-all duration-500 ease-out flex justify-center py-2" id="device-frame-container">
    
    <!-- 1. DESKTOP BROWSER FRAME (Visible by default) -->
    <div id="frame-desktop" class="w-full rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 shadow-2xl overflow-hidden transition-all duration-300">
      <!-- Browser Top Bar -->
      <div class="bg-slate-100 dark:bg-slate-900 px-4 py-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
        </div>

        <!-- Simulated Browser Address Bar -->
        <div class="flex-1 max-w-md mx-auto bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-1 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 font-mono shadow-xs">
          <span class="text-emerald-500">🔒</span>
          <span class="truncate">https://app.roommatesexpensemanager.com/group/indore-flat</span>
        </div>

        <div class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Interactive Preview</span>
        </div>
      </div>

      <!-- App Content Area (Desktop Layout) -->
      <div class="bg-slate-50/70 dark:bg-slate-950 text-slate-900 dark:text-slate-100 p-4 sm:p-6 space-y-6 min-h-[530px] relative transition-colors duration-200">
        <!-- App Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800">
          <div class="flex items-center gap-3">
            <BrandLogo size={36} showText={false} />
            <div>
              <div class="flex items-center gap-2">
                <h3 class="font-extrabold text-slate-900 dark:text-white text-base sm:text-lg">Indore Flat 🏠</h3>
                <span class="text-[10px] bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-2 py-0.5 rounded-md font-mono font-medium">ROOM-ETVT</span>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400">
                3 Roommates · Signed in as <strong class="text-[#00966d] dark:text-[#00e599]">Amar (You)</strong>
              </p>
            </div>
          </div>

          <!-- Desktop Navigation Pills -->
          <div class="flex items-center gap-1 bg-white dark:bg-slate-900 p-1 rounded-xl border border-slate-200 dark:border-slate-800 text-xs font-semibold shadow-xs">
            <button type="button" class="sim-tab-btn px-3 py-1.5 rounded-lg bg-[#00966d] text-white transition cursor-pointer" data-tab="overview">
              Overview
            </button>
            <button type="button" class="sim-tab-btn px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition" data-tab="sheet">
              📊 Spreadsheet Matrix
            </button>
            <button type="button" class="sim-tab-btn px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition" data-tab="settle">
              💳 Settle Up
            </button>
            <button type="button" class="sim-tab-btn px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition" data-tab="roommates">
              👥 Roommates
            </button>
          </div>
        </div>

        <!-- TAB 1: OVERVIEW -->
        <div id="desktop-view-overview" class="desktop-tab-view space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-indigo-500/30 shadow-sm relative overflow-hidden">
              <span class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Your Net Balance</span>
              <div class="flex items-baseline gap-2 mt-1">
                <span id="desktop-net-balance" class="text-3xl font-black text-emerald-600 dark:text-emerald-400 transition-all duration-500">+₹10,000</span>
                <span class="text-xs text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded-full">Flat owes you</span>
              </div>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">
                All bills reconciled. Group sum = <strong class="text-slate-900 dark:text-white">₹0</strong>
              </p>
            </div>

            <div class="md:col-span-2 p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">
                  ⚡ Simplified Direct Transfers
                </span>
                <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold">2 Payments Settle Everything</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 flex items-center justify-between">
                  <span>👉 <strong class="text-amber-600 dark:text-amber-400">Akbar</strong> pays <strong class="text-[#00966d] dark:text-[#00e599]">Amar</strong></span>
                  <span id="desktop-akbar-dues" class="font-bold text-emerald-600 dark:text-emerald-400">₹4,000</span>
                </div>
                <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 flex items-center justify-between">
                  <span>👉 <strong class="text-purple-600 dark:text-purple-400">Anthony</strong> pays <strong class="text-[#00966d] dark:text-[#00e599]">Amar</strong></span>
                  <span id="desktop-anthony-dues" class="font-bold text-emerald-600 dark:text-emerald-400">₹6,000</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Activity Feed -->
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <h4 class="font-bold text-sm text-slate-900 dark:text-white">Recent Flat Activity</h4>
              <button
                type="button"
                id="btn-desktop-add"
                class="px-3.5 py-1.5 rounded-full bg-[#00966d] hover:bg-[#00ab7d] text-white text-xs font-normal transition flex items-center gap-1.5 cursor-pointer active:scale-95"
              >
                <span>+ Add Expense (&lt;10s)</span>
              </button>
            </div>

            <div class="space-y-2">
              <div id="desktop-new-expense-row" class="hidden p-3.5 rounded-xl bg-slate-100 dark:bg-slate-900 border border-black/10 dark:border-white/10 transition-all duration-500">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-emerald-100 dark:bg-emerald-600/20 text-emerald-600 dark:text-emerald-400 font-bold text-sm flex items-center justify-center border border-emerald-200 dark:border-emerald-500/30">🍕</div>
                    <div>
                      <h5 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                        <span>Swiggy Dinner</span>
                        <span class="text-[10px] bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 px-1.5 py-0.2 rounded font-semibold animate-pulse">Just Added</span>
                      </h5>
                      <p class="text-xs text-slate-500 dark:text-slate-400">Paid by Amar (You) • Split equally (₹400 each)</p>
                    </div>
                  </div>
                  <span class="text-sm font-black text-slate-900 dark:text-white">₹1,200</span>
                </div>
              </div>

              <div class="p-3.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex items-center justify-between shadow-xs">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-800 text-[#00966d] dark:text-[#00e599] font-bold text-sm flex items-center justify-center border border-black/5 dark:border-white/10">🏠</div>
                  <div>
                    <h5 class="font-bold text-sm text-slate-900 dark:text-white">Flat Rent</h5>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Paid by Amar • Split among 3 roommates</p>
                  </div>
                </div>
                <span class="text-sm font-bold text-slate-900 dark:text-white">₹15,000</span>
              </div>

              <div class="p-3.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex items-center justify-between shadow-xs">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-xl bg-amber-100 dark:bg-amber-600/20 text-amber-600 dark:text-amber-400 font-bold text-sm flex items-center justify-center border border-amber-200 dark:border-amber-500/30">🛒</div>
                  <div>
                    <h5 class="font-bold text-sm text-slate-900 dark:text-white">DMart Groceries</h5>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Paid by Akbar • Split among 3 roommates</p>
                  </div>
                </div>
                <span class="text-sm font-bold text-slate-900 dark:text-white">₹3,000</span>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 2: SPREADSHEET MATRIX -->
        <div id="desktop-view-sheet" class="desktop-tab-view hidden space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <h4 class="font-bold text-sm text-slate-900 dark:text-white">Real-Time Spreadsheet Matrix</h4>
              <p class="text-xs text-slate-500 dark:text-slate-400">Rows = Bills, Columns = Individual Shares.</p>
            </div>
            <span class="text-xs px-3 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold border border-emerald-200 dark:border-emerald-500/30">
              Live .xlsx Sync
            </span>
          </div>

          <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 text-xs shadow-sm">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-400 font-bold uppercase text-[10px]">
                  <th class="p-3">Expense</th>
                  <th class="p-3">Total</th>
                  <th class="p-3">Payer</th>
                  <th class="p-3 text-center text-[#00966d] dark:text-[#00e599]">Amar</th>
                  <th class="p-3 text-center text-amber-600 dark:text-amber-400">Akbar</th>
                  <th class="p-3 text-center text-purple-600 dark:text-purple-400">Anthony</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
                <tr id="desktop-sheet-new-row" class="hidden bg-[#00966d]/10 dark:bg-[#00966d]/20 font-semibold transition">
                  <td class="p-3 text-slate-900 dark:text-white">🍕 Swiggy Dinner</td>
                  <td class="p-3 text-slate-900 dark:text-white">₹1,200</td>
                  <td class="p-3 text-[#00966d] dark:text-[#00e599]">Amar</td>
                  <td class="p-3 text-center font-mono">₹400</td>
                  <td class="p-3 text-center font-mono">₹400</td>
                  <td class="p-3 text-center font-mono">₹400</td>
                </tr>
                <tr>
                  <td class="p-3 font-medium text-slate-900 dark:text-white">Flat Rent</td>
                  <td class="p-3 font-bold text-slate-900 dark:text-white">₹15,000</td>
                  <td class="p-3 text-[#00966d] dark:text-[#00e599]">Amar</td>
                  <td class="p-3 text-center font-mono">₹5,000</td>
                  <td class="p-3 text-center font-mono">₹5,000</td>
                  <td class="p-3 text-center font-mono">₹5,000</td>
                </tr>
                <tr>
                  <td class="p-3 font-medium text-slate-900 dark:text-white">DMart Groceries</td>
                  <td class="p-3 font-bold text-slate-900 dark:text-white">₹3,000</td>
                  <td class="p-3 text-amber-600 dark:text-amber-400">Akbar</td>
                  <td class="p-3 text-center font-mono">₹1,000</td>
                  <td class="p-3 text-center font-mono">₹1,000</td>
                  <td class="p-3 text-center font-mono">₹1,000</td>
                </tr>
              </tbody>
              <tfoot>
                <tr class="bg-[#00966d]/10 dark:bg-[#00966d]/20 border-t border-[#00966d]/30 font-bold text-xs">
                  <td colspan="3" class="p-3 text-right uppercase text-slate-500 dark:text-slate-400">Net Settle:</td>
                  <td id="desktop-matrix-amar" class="p-3 text-center font-mono text-emerald-600 dark:text-emerald-400 font-black">+₹10,000</td>
                  <td id="desktop-matrix-akbar" class="p-3 text-center font-mono text-rose-600 dark:text-rose-400 font-black">-₹4,000</td>
                  <td id="desktop-matrix-anthony" class="p-3 text-center font-mono text-rose-600 dark:text-rose-400 font-black">-₹6,000</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>

        <!-- TAB 3: SETTLE UP -->
        <div id="desktop-view-settle" class="desktop-tab-view hidden space-y-4">
          <h4 class="font-bold text-sm text-slate-900 dark:text-white">Minimal Debt Transfers (Greedy Settle)</h4>
          <div class="space-y-3">
            <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-between shadow-xs">
              <div>
                <p class="text-sm font-bold text-slate-900 dark:text-white">Akbar owes you ₹4,000</p>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-mono">UPI: akbar@okhdfcbank</p>
              </div>
              <button type="button" class="px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition cursor-pointer">
                Record Payment
              </button>
            </div>
            <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-between shadow-xs">
              <div>
                <p class="text-sm font-bold text-slate-900 dark:text-white">Anthony owes you ₹6,000</p>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-mono">UPI: anthony@oksbi</p>
              </div>
              <button type="button" class="px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition cursor-pointer">
                Record Payment
              </button>
            </div>
          </div>
        </div>

        <!-- TAB 4: ROOMMATES -->
        <div id="desktop-view-roommates" class="desktop-tab-view hidden space-y-4">
          <h4 class="font-bold text-sm text-slate-900 dark:text-white">Flat Roommates (3)</h4>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-1">
              <span class="font-bold text-sm text-slate-900 dark:text-white block">Amar (You)</span>
              <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold block">Flat owes you ₹10,000</span>
              <span class="text-[11px] text-slate-500 font-mono">+91 98260XXXXX</span>
            </div>
            <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-1">
              <span class="font-bold text-sm text-slate-900 dark:text-white block">Akbar</span>
              <span class="text-xs text-rose-600 dark:text-rose-400 font-semibold block">Owes flat ₹4,000</span>
              <span class="text-[11px] text-slate-500 font-mono">+91 97130XXXXX</span>
            </div>
            <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-1">
              <span class="font-bold text-sm text-slate-900 dark:text-white block">Anthony</span>
              <span class="text-xs text-rose-600 dark:text-rose-400 font-semibold block">Owes flat ₹6,000</span>
              <span class="text-[11px] text-slate-500 font-mono">+91 95593XXXXX</span>
            </div>
          </div>
        </div>
      </div>
    </div>


    <!-- 2. AUTHENTIC SMARTPHONE FRAME (iPhone Chassis + Dynamic Island + BottomNav) -->
    <div id="frame-mobile" class="hidden w-full max-w-[380px] rounded-[48px] p-3 bg-slate-900 dark:bg-slate-800 border-4 border-slate-700/80 shadow-2xl ring-1 ring-black/30 transition-all duration-300">
      
      <!-- Phone Inner Screen -->
      <div class="rounded-[38px] bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 overflow-hidden flex flex-col h-[680px] relative border border-slate-300 dark:border-slate-800 transition-colors duration-200">
        
        <!-- Status Bar & Dynamic Island -->
        <div class="pt-3 px-6 pb-2 flex items-center justify-between text-[11px] font-bold text-slate-900 dark:text-white shrink-0 select-none">
          <span>9:41</span>
          
          <!-- Dynamic Island -->
          <div class="w-24 h-5 bg-black rounded-full flex items-center justify-end pr-2 gap-1.5 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          </div>

          <div class="flex items-center gap-1.5 text-xs">
            <span>5G</span>
            <!-- Battery Icon -->
            <div class="w-5 h-2.5 rounded-[4px] border border-slate-700 dark:border-slate-300 p-0.5 flex items-center">
              <div class="w-full h-full bg-emerald-500 rounded-[2px]"></div>
            </div>
          </div>
        </div>

        <!-- Phone Top App Bar -->
        <div class="px-4 py-2.5 bg-white/90 dark:bg-slate-900/90 backdrop-blur border-b border-slate-200 dark:border-slate-800 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-2">
            <BrandLogo size={28} showText={false} />
            <div>
              <h4 class="font-extrabold text-xs text-slate-900 dark:text-white leading-tight">Indore Flat 🏠</h4>
              <p class="text-[10px] text-slate-500 dark:text-slate-400">Amar (You) · ROOM-ETVT</p>
            </div>
          </div>

          <button
            type="button"
            id="btn-mobile-add"
            class="px-2.5 py-1 bg-[#00966d] hover:bg-[#00ab7d] text-white rounded-lg text-[11px] font-bold shadow-xs cursor-pointer flex items-center gap-1 active:scale-95"
          >
            <span>+ Add</span>
          </button>
        </div>

        <!-- Scrollable Phone Screen Content -->
        <div class="flex-1 overflow-y-auto p-4 space-y-4">
          
          <!-- MOBILE VIEW 1: OVERVIEW -->
          <div id="mobile-view-overview" class="mobile-tab-view space-y-4">
            <!-- Net Balance Card -->
            <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-[#00966d]/30 shadow-xs">
              <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Your Net Balance</span>

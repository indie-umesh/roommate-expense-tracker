---
interface Props {
  size?: number;
  showText?: boolean;
  className?: string;
  textClassName?: string;
}

const {
  size = 28,
  showText = true,
  className = '',
  textClassName = 'font-semibold text-[16px] tracking-tight text-[#1d1d1f] dark:text-white'
} = Astro.props;
---

<div class={`inline-flex items-center gap-2.5 ${className}`}>
  <!-- Vector Brand Mark -->
  <div style={`width: ${size}px; height: ${size}px;`} class="shrink-0 transition-transform duration-200 group-hover:scale-105">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="100%" height="100%" class="w-full h-full drop-shadow-xs">
      <defs>
        <linearGradient id="astroLogoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#00c48c" />
          <stop offset="100%" stop-color="#00805a" />
        </linearGradient>
        <linearGradient id="astroLogoRim" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.45" />
          <stop offset="50%" stop-color="#ffffff" stop-opacity="0.08" />
          <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
        </linearGradient>
      </defs>

      <rect x="6" y="6" width="108" height="108" rx="28" fill="url(#astroLogoGrad)" />
      <rect x="6.75" y="6.75" width="106.5" height="106.5" rx="27.25" fill="none" stroke="url(#astroLogoRim)" stroke-width="1.5" />

      <g fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round">
        <line x1="33" y1="36" x2="87" y2="36" stroke-width="8" />
        <line x1="33" y1="49" x2="73" y2="49" stroke-width="8" />
        <line x1="43" y1="36" x2="43" y2="88" stroke-width="8.5" />
        <path d="M43,36 H66 C78,36 85,44 85,55 C85,66 78,73 65,73 H43" stroke-width="8" />
        <path d="M61,72 L82,88" stroke-width="8.5" />
      </g>
      <circle cx="64" cy="55" r="3.5" fill="#ff385c" />
    </svg>
  </div>

  {showText && (
    <span class={textClassName}>
      RoomMate<span class="text-[#00966d] dark:text-[#00e599]">ExpenseTracker</span>
    </span>
  )}
</div>

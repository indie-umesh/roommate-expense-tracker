---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishDate?: string;
  modifiedDate?: string;
  faqSchema?: Array<{ question: string; answer: string }>;
  articleSchema?: {
    headline: string;
    description: string;
    datePublished: string;
    dateModified?: string;
    authorName?: string;
  };
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description,
  keywords = "roommate expense tracker, roommate expense tracker app, roommate expense tracker google sheets, roommate expense tracker excel, shared expense tracker app free, splitwise alternative, bill split app",
  canonicalUrl = Astro.url.href,
  ogType = 'website',
  ogImage = 'https://roommatesexpensemanager.com/og-image.png',
  publishDate,
  modifiedDate,
  faqSchema,
  articleSchema,
  breadcrumbs = [
    { name: "Home", url: "https://roommatesexpensemanager.com" }
  ]
} = Astro.props;

const siteUrl = "https://roommatesexpensemanager.com";
const appUrl = "http://192.168.1.6:5173"; // Or production app URL https://app.roommatesexpensemanager.com

// Base JSON-LD SoftwareApplication Schema
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Roommate Expense Tracker",
  "operatingSystem": "Web, iOS, Android (PWA)",
  "applicationCategory": "FinanceApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "ratingCount": "1280",
    "bestRating": "5",
    "worstRating": "1"
  },
  "description": "Fast, 100% free roommate expense tracker and shared bill splitter. Add expenses in under 3 taps, view live Excel sheet balance matrices, simplify debts with zero friction.",
  "url": siteUrl
};

// FAQ Schema if provided
const faqJsonLd = faqSchema && faqSchema.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqSchema.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;

// Breadcrumb Schema
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": crumb.name,
    "item": crumb.url
  }))
};

// Article Schema if provided
const articleJsonLd = articleSchema ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": articleSchema.headline,
  "description": articleSchema.description,
  "datePublished": articleSchema.datePublished,
  "dateModified": articleSchema.dateModified || articleSchema.datePublished,
  "author": {
    "@type": "Person",
    "name": articleSchema.authorName || "Umesh Jaiswal",
    "jobTitle": "Full-Stack Engineer & Flatmate",
    "url": "https://roommatesexpensemanager.com/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Roommate",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": "https://roommatesexpensemanager.com/logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
} : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Roommate Team" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Roommate Expense Tracker" />
    {publishDate && <meta property="article:published_time" content={publishDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- AI Overview & Crawler Hints -->
    <meta name="ai-content-type" content="finance, expense-management, productivity-tool" />
    <link rel="help" href="/llms.txt" title="LLM context and crawler reference" />

    <!-- JSON-LD Structured Data for Rich Search & Google AI Overviews -->
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
    {articleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />}
  </head>

  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans selection:bg-indigo-500 selection:text-white">
    <!-- Top Announcement Bar -->
    <aside aria-label="Announcement" class="bg-gradient-to-r from-indigo-900 via-indigo-600 to-emerald-600 text-white text-xs font-semibold py-2 px-4 text-center">
      <span>🚀 Tired of Splitwise's 3-expense/day limit? Switch to Roommate — 100% Free Forever, No Ads, No Wait Times.</span>
      <a href="/splitwise-alternative" class="underline ml-2 hover:text-indigo-200">See Comparison →</a>
    </aside>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 backdrop-blur-xl bg-slate-950/80 border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded-lg p-1">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-emerald-500 text-white flex items-center justify-center font-black text-lg shadow-lg shadow-indigo-500/20 group-hover:scale-105 transition">
            ₹
          </div>
          <div>
            <span class="font-bold text-lg tracking-tight text-white block leading-tight">Roommate</span>
            <span class="text-[10px] text-emerald-400 font-medium block">Free Expense Tracker</span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300" aria-label="Main Navigation">
          <a href="/splitwise-alternative" class="hover:text-white transition">Splitwise Alternative</a>
          <a href="/roommate-expense-tracker-excel" class="hover:text-white transition">Excel View</a>
          <a href="/roommate-expense-tracker-google-sheets" class="hover:text-white transition">Google Sheets vs App</a>
          <a href="/roommate-expense-tracker-template" class="hover:text-white transition">Free Template</a>
          <a href="/blog" class="hover:text-white transition">Guides & Blog</a>
        </nav>

        <!-- CTAs -->
        <div class="flex items-center gap-3">
          <a
            href="http://localhost:5173"
            class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs sm:text-sm font-bold shadow-lg shadow-indigo-600/30 hover:shadow-indigo-600/50 transition active:scale-95 flex items-center gap-1.5"
          >
            <span>Launch Web App</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Comprehensive Hub-and-Spoke SEO Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 text-slate-400 text-sm pt-14 pb-12 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
          <!-- Col 1: About & Positioning -->
          <div class="lg:col-span-2 space-y-4">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold text-sm">₹</div>
              <span class="text-white font-bold text-base">Roommate Expense Tracker</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
              The fastest shared expense tracker built for flatmates, bachelors, and roommates. Log bills in 3 taps, view live spreadsheet matrices, handle staggered paydays, and settle accounts in under 5 minutes without awkward money chats.
            </p>
            <div class="flex items-center gap-3 pt-2">
              <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-semibold bg-emerald-950/60 border border-emerald-800/40 px-2.5 py-1 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                100% Free Forever • No Ads • Zero Friction
              </span>
            </div>
          </div>

          <!-- Col 2: Core Keywords & Tool Pages -->
          <div class="space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Expense Tools</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/" class="hover:text-white transition">Roommate Expense Tracker App</a></li>
              <li><a href="/shared-expense-tracker-app-free" class="hover:text-white transition">Shared Expense Tracker Free</a></li>
              <li><a href="/roommate-expense-tracker-excel" class="hover:text-white transition">Roommate Expense Tracker Excel</a></li>
              <li><a href="/roommate-expense-tracker-google-sheets" class="hover:text-white transition">Roommate Google Sheets View</a></li>
              <li><a href="/roommate-expense-tracker-template" class="hover:text-white transition">Roommate Bill Split Template</a></li>
            </ul>
          </div>

          <!-- Col 3: Competitor Alternatives -->
          <div class="space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Alternatives</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/splitwise-alternative" class="hover:text-white transition font-medium text-indigo-400">Splitwise Alternative 2026</a></li>
              <li><a href="/splitwise-alternative#limits" class="hover:text-white transition">Splitwise Daily Limit Workaround</a></li>
              <li><a href="/tricount-alternative" class="hover:text-white transition">Tricount Alternative</a></li>
              <li><a href="/settle-up-alternative" class="hover:text-white transition">Settle Up Alternative</a></li>
              <li><a href="/splitwise-alternative#pricing" class="hover:text-white transition">Splitwise Pro Pricing Breakdown</a></li>
            </ul>
          </div>

          <!-- Col 4: Expert Blog Guides -->
          <div class="space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Guides & Articles</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/blog/why-google-sheets-fails-for-roommates" class="hover:text-white transition">Why Google Sheets Fails</a></li>
              <li><a href="/blog/how-to-manage-different-paydays-with-roommates" class="hover:text-white transition">Managing Different Paydays</a></li>
              <li><a href="/blog/splitwise-limits-and-best-free-alternatives-2026" class="hover:text-white transition">Best Free Bill Split Apps</a></li>
              <li><a href="/blog/how-to-split-rent-and-groceries-equitably" class="hover:text-white transition">Fair Rent & Grocery Split Rules</a></li>
              <li><a href="/blog" class="hover:text-white transition font-medium text-emerald-400">View All Blog Posts →</a></li>
            </ul>
          </div>
        </div>

        <!-- Bottom Bar -->
        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
          <p>© {new Date().getFullYear()} Roommate Expense Tracker. Built with care for flatmates everywhere.</p>
          <div class="flex items-center gap-6">
            <a href="/llms.txt" class="hover:text-slate-300 text-slate-400 font-mono">llms.txt (AI Overview)</a>
            <a href="/sitemap-index.xml" class="hover:text-slate-300">XML Sitemap</a>
            <a href="http://localhost:5173" class="hover:text-white text-indigo-400 font-semibold">Web App Login</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

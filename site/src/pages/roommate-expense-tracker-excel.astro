---
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_URL } from '../config/site';
import ExcelMatrixPreview from '../components/ExcelMatrixPreview.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const title = "Expense Tracker Excel — Roommate";
const description = "Download free roommate expense tracker Excel templates, or use our automated web app with real-time spreadsheet balance matrices and 1-click .xlsx export.";
const keywords = "roommate expense tracker excel, roommate expense tracker spreadsheet, free excel template for roommate expenses, bill split excel template, flat expense spreadsheet";

const excelFaq = [
  {
    question: "Why do manual Excel spreadsheets break when roommates use them?",
    answer: "Excel works great until someone accidentally overwrites a SUM formula, enters text in a currency cell, or deletes a column. When you have 3 or 4 flatmates editing the same workbook, formula synchronization errors and version conflicts always happen."
  },
  {
    question: "How does Roommate combine the best of Excel with an app?",
    answer: "Roommate gives you the exact matrix layout of an Excel spreadsheet (rows = expenses, columns = roommate shares, bottom row = net balances) backed by a robust PostgreSQL database with mathematical invariant guarantees (paise sum strictly = 0). You can also export your ledger to .xlsx in 1 click."
  },
  {
    question: "Can I export my Roommate data to Microsoft Excel or Google Sheets?",
    answer: "Yes! There is a one-click 'Export to Excel (.xlsx)' button in the Spreadsheet view. All math, timestamps, and roommate shares are formatted cleanly for Excel, LibreOffice, or Google Sheets."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  faqSchema={excelFaq}
  breadcrumbs={[
    { name: "Home", url: "https://roommatesexpensemanager.com" },
    { name: "Excel Expense Tracker", url: "https://roommatesexpensemanager.com/roommate-expense-tracker-excel" }
  ]}
>
  <!-- Hero Section (Apple Clean Canvas) -->
  <section class="pt-16 pb-16 bg-white dark:bg-black transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 text-center space-y-5">
      <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">
        The Best of Spreadsheets + Instant Mobile Entry
      </p>

      <div class="space-y-2">
        <h1 class="apple-hero-display text-[#1d1d1f] dark:text-white">
          Roommate Expense Tracker Excel
        </h1>
        <p class="text-[20px] sm:text-[28px] font-semibold text-[#86868b] dark:text-[#a1a1a6] tracking-tight">
          Live balance matrix with 1-click XLSX export
        </p>
      </div>

      <p class="text-[16px] sm:text-[17px] text-[#86868b] dark:text-[#a1a1a6] max-w-2xl mx-auto leading-relaxed">
        Love spreadsheet transparency but hate broken formulas and complex mobile data entry? Roommate gives you a live Excel-style ledger on web and mobile, with 1-click client-side .xlsx export.
      </p>

      <div class="flex items-center justify-center gap-6 pt-2">
        <a
          href={APP_URL}
          class="apple-btn-primary"
        >
          Open Live Spreadsheet App
        </a>
      </div>
    </div>
  </section>

  <!-- Live Matrix Showcase (Apple Parchment) -->
  <section class="py-20 bg-[#f5f5f7] dark:bg-[#161617] border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6">
      <ExcelMatrixPreview />
    </div>
  </section>

  <!-- Comparison: Manual Excel vs Roommate App (Apple Pure Canvas) -->
  <section class="py-20 bg-white dark:bg-black border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">Feature Contrast</p>
        <h2 class="apple-display-lg text-[#1d1d1f] dark:text-white">
          Manual Spreadsheets vs. Roommate
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 rounded-[24px] bg-[#fbfbfd] dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 space-y-4 apple-product-shadow">
          <h3 class="text-[18px] font-semibold text-[#1d1d1f] dark:text-white">Why Manual Excel Files Fail Flatmates</h3>
          <ul class="space-y-3 text-[14px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
            <li class="flex items-start gap-2.5">
              <span class="text-rose-500 font-bold">✕</span>
              <span>Typing numbers into tiny spreadsheet cells on a smartphone screen is painful at checkout.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-rose-500 font-bold">✕</span>
              <span>Formulas get corrupted or deleted when someone inserts a row incorrectly.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-rose-500 font-bold">✕</span>
              <span>Doesn't calculate greedy debt simplification—leaves you with confusing cross-debts.</span>
            </li>
          </ul>
        </div>

        <div class="p-8 rounded-[24px] bg-[#fbfbfd] dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 space-y-4 apple-product-shadow">
          <h3 class="text-[18px] font-semibold text-[#1d1d1f] dark:text-white">How Roommate Solves It Perfectly</h3>
          <ul class="space-y-3 text-[14px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Add bills in &le; 3 taps on mobile, and the spreadsheet matrix updates automatically in real-time.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Database invariants ensure total group balances always sum to exactly zero (zero rounding errors).</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Export to clean Microsoft Excel (.xlsx) anytime with 1 click for official flat records.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section (Apple Parchment) -->
  <section class="py-20 bg-[#f5f5f7] dark:bg-[#161617] border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6">
      <FaqAccordion
        items={excelFaq}
        title="Roommate Excel Expense Tracker FAQ"
        subtitle="Everything you need to know about Excel matrices and export."
      />
    </div>
  </section>
</BaseLayout>

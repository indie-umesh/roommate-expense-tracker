---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExcelMatrixPreview from '../components/ExcelMatrixPreview.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const title = "Roommate Expense Tracker Excel — Live Spreadsheet View & .XLSX Export";
const description = "Download free roommate expense tracker Excel templates, or use our automated web app with built-in real-time spreadsheet matrix views and instant client-side .xlsx exports.";
const keywords = "roommate expense tracker excel, roommate expense tracker spreadsheet, free excel template for roommate expenses, bill split excel template, flat expense spreadsheet";

const excelFaq = [
  {
    question: "Why do manual Excel spreadsheets break when roommates use them?",
    answer: "Excel works great until someone accidentally overwrites a SUM formula, enters text in a currency cell, or deletes a column. When you have 3 or 4 flatmates editing the same workbook, formula synchronization errors and version conflicts always happen."
  },
  {
    question: "How does Roommate combine the best of Excel with an app?",
    answer: "Roommate gives you the exact matrix layout of an Excel spreadsheet (rows = expenses, columns = roommate shares, bottom row = net balances) backed by a robust PostgreSQL database with mathematical invariant guarantees (paise sum strictly = 0). You can also export your ledger to .xlsx in 1 click."
  },
  {
    question: "Can I export my Roommate data to Microsoft Excel or Google Sheets?",
    answer: "Yes! There is a one-click 'Export to Excel (.xlsx)' button in the Spreadsheet view. All math, timestamps, and roommate shares are formatted cleanly for Excel, LibreOffice, or Google Sheets."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  faqSchema={excelFaq}
  breadcrumbs={[
    { name: "Home", url: "https://roommatesexpensemanager.com" },
    { name: "Excel Expense Tracker", url: "https://roommatesexpensemanager.com/roommate-expense-tracker-excel" }
  ]}
>
  <section class="pt-16 pb-12 max-w-4xl mx-auto px-4 text-center space-y-6">
    <span class="px-3.5 py-1.5 rounded-full bg-emerald-950/70 border border-emerald-800/60 text-xs font-semibold text-emerald-300">
      The Best of Spreadsheets + Instant Mobile Entry
    </span>

    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
      Roommate Expense Tracker <br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">
        In Live Excel Matrix View
      </span>
    </h1>

    <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Love spreadsheet transparency but hate broken formulas and complex mobile data entry? Roommate gives you a live Excel-style ledger on web and mobile, with 1-click client-side .xlsx export.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
      <a
        href="http://localhost:5173"
        class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-extrabold text-sm shadow-xl transition"
      >
        Open Live Spreadsheet App →
      </a>
    </div>
  </section>

  <!-- Live Matrix Showcase -->
  <section class="py-12 max-w-5xl mx-auto px-4">
    <ExcelMatrixPreview />
  </section>

  <!-- Comparison: Manual Excel vs Roommate App -->
  <section class="py-16 max-w-5xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="p-6 rounded-3xl bg-slate-950/80 border border-rose-900/40 space-y-4">
        <h3 class="text-lg font-bold text-rose-400">Why Manual Excel Files Fail Flatmates</h3>
        <ul class="space-y-3 text-xs text-slate-400">
          <li class="flex items-start gap-2">
            <span class="text-rose-500 font-bold">✕</span>
            <span>Typing numbers into tiny spreadsheet cells on a smartphone screen is painful at checkout.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-rose-500 font-bold">✕</span>
            <span>Formulas get corrupted or deleted when someone inserts a row incorrectly.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-rose-500 font-bold">✕</span>
            <span>Doesn't calculate greedy debt simplification—leaves you with confusing cross-debts.</span>
          </li>
        </ul>
      </div>

      <div class="p-6 rounded-3xl bg-slate-950/80 border border-emerald-900/40 space-y-4">
        <h3 class="text-lg font-bold text-emerald-400">How Roommate Solves It Perfectly</h3>
        <ul class="space-y-3 text-xs text-slate-300">
          <li class="flex items-start gap-2">
            <span class="text-emerald-400 font-bold">✓</span>
            <span>Add bills in ≤ 3 taps on mobile, and the spreadsheet updates automatically in real-time.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400 font-bold">✓</span>
            <span>Database invariants ensure total group balances always sum to exactly zero (zero rounding errors).</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400 font-bold">✓</span>
            <span>Export to clean Microsoft Excel (.xlsx) anytime with 1 click for official flat records.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-12 max-w-5xl mx-auto px-4">
    <FaqAccordion items={excelFaq} title="Roommate Excel Expense Tracker FAQ" />
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Guides & Blog — Roommate";
const description = "Expert guides on splitting rent, groceries, solving asynchronous paydays, and finding the best free expense tools for roommates in shared flats.";
const keywords = "roommate expense guides, how to split rent, roommate bills, splitwise alternative blog, flat budgeting tips";

const articles = [
  {
    slug: "why-google-sheets-fails-for-roommates",
    title: "Why Google Sheets Fails for Roommates (The Entry Friction Problem)",
    description: "Spreadsheets have great math, but terrible mobile UX. Here is why flatmates abandon Google Sheets within 3 weeks and how 3-tap logging changes everything.",
    date: "Nov 20, 2026",
    readTime: "5 min read",
    category: "Productivity & UX"
  },
  {
    slug: "how-to-manage-different-paydays-with-roommates",
    title: "How to Manage Different Paydays Between Roommates Without Fighting",
    description: "What happens when Anthony gets paid on the 1st, Akbar on the 5th, and Amar on the 15th? A practical system to cover bills without resentment.",
    date: "Nov 18, 2026",
    readTime: "6 min read",
    category: "Financial Strategy"
  },
  {
    slug: "splitwise-limits-and-best-free-alternatives-2026",
    title: "Splitwise Limitations in 2026: Why You Need a Dedicated Free Alternative",
    description: "An honest review of Splitwise's 3-expense/day cap, 10-second wait timers, and Pro paywalls—plus the top free alternatives for shared flats.",
    date: "Nov 15, 2026",
    readTime: "7 min read",
    category: "App Comparisons"
  },
  {
    slug: "how-to-split-rent-and-groceries-equitably",
    title: "How to Split Rent, Groceries, and Utilities Fairly (Formulas That Work)",
    description: "Master bedrooms, personal snacks vs shared oil, and air conditioning power surges. Formulas and ground rules for fair room expense sharing.",
    date: "Nov 12, 2026",
    readTime: "6 min read",
    category: "Flatmate Etiquette"
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  breadcrumbs={[
    { name: "Home", url: "https://roommatesexpensemanager.com" },
    { name: "Blog", url: "https://roommatesexpensemanager.com/blog" }
  ]}
>
  <section class="pt-16 pb-20 bg-white dark:bg-black transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 space-y-10">
      
      <!-- Editorial Header -->
      <div class="max-w-2xl space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff]">
          Knowledge Base & Guides
        </span>
        <h1 class="apple-hero-display text-[#1d1d1f] dark:text-white">
          Guides to Zero-Stress Shared Living
        </h1>
        <p class="text-[17px] sm:text-[18px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
          Actionable playbooks, mathematical split formulas, and real flatmate stories on managing money together without tension.
        </p>
      </div>

      <!-- Articles Grid (Apple Editorial 2-Col Cards) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
        {articles.map((art) => (
          <article class="p-7 rounded-[24px] bg-[#fbfbfd] dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 apple-card-interactive flex flex-col justify-between space-y-5 group shadow-sm hover:shadow-md">
            <div class="space-y-3.5">
              <div class="flex items-center justify-between text-xs">
                <span class="px-3 py-1 rounded-full bg-[#f5f5f7] dark:bg-[#262629] text-[#0066cc] dark:text-[#2997ff] font-semibold border border-black/5 dark:border-white/5">
                  {art.category}
                </span>
                <span class="text-[#86868b] font-medium">{art.readTime}</span>
              </div>
              
              <h2 class="text-[19px] sm:text-[21px] font-semibold text-[#1d1d1f] dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition leading-snug">
                <a href={`/blog/${art.slug}`}>{art.title}</a>
              </h2>
              
              <p class="text-[14px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
                {art.description}
              </p>
            </div>

            <div class="pt-4 border-t border-black/6 dark:border-white/8 flex items-center justify-between text-xs text-[#86868b]">
              <span>{art.date}</span>
              <a href={`/blog/${art.slug}`} class="apple-btn-secondary text-[13px] py-1.5 px-3.5">
                <span>Read Guide</span>
                <span aria-hidden="true">›</span>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>

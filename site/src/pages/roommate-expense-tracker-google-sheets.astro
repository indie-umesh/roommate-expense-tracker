---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExcelMatrixPreview from '../components/ExcelMatrixPreview.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const title = "Roommate Expense Tracker Google Sheets: Why It Fails & What to Use Instead";
const description = "Looking for a roommate expense tracker Google Sheets template? Learn why manual sheets cause entry friction, and how Roommate gives you 3-tap mobile entry with spreadsheet transparency.";
const keywords = "roommate expense tracker google sheets, shared expense tracker google sheets, google sheets bill split template, roommate expense spreadsheet";

const sheetsFaq = [
  {
    question: "Why do roommates stop using Google Sheets after 2 or 3 weeks?",
    answer: "The problem is 'entry friction'. When buying groceries or milk, nobody wants to open Google Drive on their phone, wait for Google Sheets to load, find the right tab, pinch-to-zoom into tiny columns, and type numbers. Because it's inconvenient, bills are postponed until month-end, when nobody remembers who bought what."
  },
  {
    question: "Does Roommate replace or work with Google Sheets?",
    answer: "Roommate replaces the painful mobile data-entry part while retaining all the analytical benefits of Google Sheets. You log bills in 3 taps (&lt;10s), and Roommate automatically builds a clean spreadsheet matrix that you can view in-app or export to Google Sheets via .xlsx."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  faqSchema={sheetsFaq}
  breadcrumbs={[
    { name: "Home", url: "https://roommatesexpensemanager.com" },
    { name: "Google Sheets Alternative", url: "https://roommatesexpensemanager.com/roommate-expense-tracker-google-sheets" }
  ]}
>
  <section class="pt-16 pb-12 max-w-4xl mx-auto px-4 text-center space-y-6">
    <span class="px-3.5 py-1.5 rounded-full bg-amber-950/70 border border-amber-800/60 text-xs font-semibold text-amber-300">
      The "Entry Friction" Paradox
    </span>

    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
      Roommate Expense Tracker <br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-indigo-400">
        Google Sheets vs. Roommate App
      </span>
    </h1>

    <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Almost every flat starts with a Google Sheet. And almost every flat abandons it within a month. Here’s why it fails, and how Roommate eliminates the pain.
    </p>

    <div class="pt-2">
      <a href="http://localhost:5173" class="px-8 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-extrabold text-sm shadow-xl transition">
        Try the 3-Tap Web App Free →
      </a>
    </div>
  </section>

  <!-- Step-by-Step Friction Breakdown -->
  <section class="py-12 max-w-4xl mx-auto px-4">
    <div class="p-8 rounded-3xl bg-slate-900/60 border border-slate-800 space-y-6">
      <h3 class="text-xl font-bold text-white text-center">The Friction Comparison at the Grocery Counter</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
        <div class="p-5 rounded-2xl bg-rose-950/20 border border-rose-900/40 space-y-3">
          <div class="font-bold text-rose-400 uppercase tracking-wider">Google Sheets: 12 Steps (45 Seconds)</div>
          <ol class="list-decimal list-inside space-y-1.5 text-slate-400 leading-relaxed">
            <li>Open Google Drive app</li>
            <li>Locate the flat spreadsheet</li>
            <li>Wait for spreadsheet cells to load</li>
            <li>Switch to the current month's tab</li>
            <li>Pinch and zoom to find the next empty row</li>
            <li>Tap cell and wait for keyboard to pop up</li>
            <li>Type the date and description</li>
            <li>Move to next cell, type amount</li>
            <li>Select who paid and shares</li>
            <li>Accidentally break an adjacent formula</li>
            <li>Close app feeling annoyed</li>
            <li>Give up after 2 weeks</li>
          </ol>
        </div>

        <div class="p-5 rounded-2xl bg-emerald-950/20 border border-emerald-900/40 space-y-3">
          <div class="font-bold text-emerald-400 uppercase tracking-wider">Roommate: 3 Taps (7 Seconds)</div>
          <ol class="list-decimal list-inside space-y-1.5 text-slate-200 leading-relaxed">
            <li>Open Roommate from home screen (instant)</li>
            <li>Type amount & details</li>
            <li>Tap participants and click Save</li>
            <li>Done! Math and debt simplification updated instantly</li>
            <li>Never broken, always accurate at month-end</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 max-w-5xl mx-auto px-4">
    <ExcelMatrixPreview />
  </section>

  <section class="py-12 max-w-5xl mx-auto px-4">
    <FaqAccordion items={sheetsFaq} title="Google Sheets Expense Tracker FAQ" />
  </section>
</BaseLayout>

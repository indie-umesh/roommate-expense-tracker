---
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_URL } from '../config/site';
import ExcelMatrixPreview from '../components/ExcelMatrixPreview.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const title = "Google Sheets vs App — Roommate";
const description = "Looking for a roommate expense tracker Google Sheets template? Learn why manual sheets fail and how Roommate gives you 3-tap mobile entry with full sheet view.";
const keywords = "roommate expense tracker google sheets, shared expense tracker google sheets, google sheets bill split template, roommate expense spreadsheet";

const sheetsFaq = [
  {
    question: "Why do roommates stop using Google Sheets after 2 or 3 weeks?",
    answer: "The problem is 'entry friction'. When buying groceries or milk, nobody wants to open Google Drive on their phone, wait for Google Sheets to load, find the right tab, pinch-to-zoom into tiny columns, and type numbers. Because it's inconvenient, bills are postponed until month-end, when nobody remembers who bought what."
  },
  {
    question: "Does Roommate replace or work with Google Sheets?",
    answer: "Roommate replaces the painful mobile data-entry part while retaining all the analytical benefits of Google Sheets. You log bills in 3 taps (&lt;10s), and Roommate automatically builds a clean spreadsheet matrix that you can view in-app or export to Google Sheets via .xlsx."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  faqSchema={sheetsFaq}
  breadcrumbs={[
    { name: "Home", url: "https://roommatesexpensemanager.com" },
    { name: "Google Sheets Alternative", url: "https://roommatesexpensemanager.com/roommate-expense-tracker-google-sheets" }
  ]}
>
  <!-- Hero Section (Apple Clean Canvas) -->
  <section class="pt-16 pb-16 bg-white dark:bg-black transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 text-center space-y-5">
      <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">
        The "Entry Friction" Paradox
      </p>

      <div class="space-y-2">
        <h1 class="apple-hero-display text-[#1d1d1f] dark:text-white">
          Google Sheets vs. Roommate
        </h1>
        <p class="text-[20px] sm:text-[28px] font-semibold text-[#86868b] dark:text-[#a1a1a6] tracking-tight">
          Why flatmates abandon shared spreadsheets within 3 weeks
        </p>
      </div>

      <p class="text-[16px] sm:text-[17px] text-[#86868b] dark:text-[#a1a1a6] max-w-2xl mx-auto leading-relaxed">
        Almost every flat starts with a Google Sheet. And almost every flat abandons it within a month. Here’s why it fails, and how Roommate eliminates the entry friction.
      </p>

      <div class="flex items-center justify-center gap-6 pt-2">
        <a
          href={APP_URL}
          class="apple-btn-primary"
        >
          Try 3-Tap Web App Free
        </a>
      </div>
    </div>
  </section>

  <!-- Step-by-Step Friction Breakdown (Apple Parchment) -->
  <section class="py-20 bg-[#f5f5f7] dark:bg-[#161617] border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">Friction Contrast</p>
        <h2 class="apple-display-lg text-[#1d1d1f] dark:text-white">
          The Experience at the Grocery Counter
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 rounded-[24px] bg-white dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 space-y-4 apple-product-shadow">
          <div class="font-semibold text-rose-500 uppercase text-[12px] tracking-wider">Google Sheets: 12 Steps (45 Seconds)</div>
          <ol class="list-decimal list-inside space-y-2 text-[14px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
            <li>Open Google Drive app</li>
            <li>Locate the flat spreadsheet</li>
            <li>Wait for spreadsheet cells to load</li>
            <li>Switch to the current month's tab</li>
            <li>Pinch and zoom to find next empty row</li>
            <li>Tap cell and wait for keyboard to pop up</li>
            <li>Type the date and description</li>
            <li>Move to next cell, type amount</li>
            <li>Select who paid and splits</li>
            <li>Accidentally break an adjacent formula</li>
            <li>Close app feeling annoyed</li>
            <li>Give up after 2 weeks</li>
          </ol>
        </div>

        <div class="p-8 rounded-[24px] bg-white dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 space-y-4 apple-product-shadow">
          <div class="font-semibold text-emerald-500 uppercase text-[12px] tracking-wider">Roommate: 3 Taps (7 Seconds)</div>
          <ol class="list-decimal list-inside space-y-2 text-[14px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
            <li>Open Roommate from home screen (instant)</li>
            <li>Type amount & details</li>
            <li>Tap participants and click Save</li>
            <li>Done! Math & debt simplification updated instantly</li>
            <li>Never broken, always accurate at month-end</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Matrix Showcase (Apple Pure Canvas) -->
  <section class="py-20 bg-white dark:bg-black border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6">
      <ExcelMatrixPreview />
    </div>
  </section>

  <!-- FAQ Section (Apple Parchment) -->
  <section class="py-20 bg-[#f5f5f7] dark:bg-[#161617] border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6">
      <FaqAccordion
        items={sheetsFaq}
        title="Google Sheets Expense Tracker FAQ"
        subtitle="Common questions about switching from spreadsheets to an instant app."
      />
    </div>
  </section>
</BaseLayout>

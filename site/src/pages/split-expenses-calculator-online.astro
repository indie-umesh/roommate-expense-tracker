---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import AnimatedFlatmates from '../components/AnimatedFlatmates.astro';

const title = "Split Expenses Calculator — Roommate";
const description = "Free online split expenses calculator. Split travel, food, and trip bills with friends in India. Zero signup, no daily limits, 1-click Excel export.";
const keywords = "split expenses calculator online, split expenses online free, split expenses calculator excel, trip expense calculator online, splitwise online calculator free, split expenses calculator online india, split expenses with friends calculator, how to split travel expenses with friends";

const splitFaqs = [
  {
    question: "Is this split expenses calculator really free with no limits?",
    answer: "Yes, 100% free forever. Unlike Splitwise which restricts free users to 3 expenses per day and adds 10-second wait times, our online calculator and web app allow unlimited expenses, unlimited groups, and zero daily caps."
  },
  {
    question: "How do I split trip or vacation expenses with friends online?",
    answer: "Enter your friends' names, log the travel costs (flights, Airbnb, rental car, fuel, meals, entry tickets), and our algorithm calculates each person's exact share. It then simplifies all debts into the smallest number of direct payments so no one is stuck doing multiple cross-transfers."
  },
  {
    question: "Does this calculator work for friends in India using UPI?",
    answer: "Yes! The settlement amounts are calculated with rupee and paise precision. In the full Roommate app, you can settle directly with 1 tap via UPI IDs (Google Pay, PhonePe, Paytm)."
  },
  {
    question: "Can I export the calculated expenses to Excel?",
    answer: "Yes, you can export the full itemized ledger to .csv and .xlsx with a single click. Every expense row, payer column, and member split is clearly organized."
  },
  {
    question: "What is the best way to handle unequal splits on a group trip?",
    answer: "For expenses where not everyone participated (e.g. 3 people went scuba diving while 2 stayed back), you can exclude non-participants so only the actual consumers share that specific line item."
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://roommatesexpensemanager.com" },
  { name: "Split Expenses Calculator Online", url: "https://roommatesexpensemanager.com/split-expenses-calculator-online" }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  faqSchema={splitFaqs}
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section with Seamlessly Embedded Calculator -->
  <section class="pt-14 pb-16 bg-[#f5f5f7] dark:bg-[#161617] border-b border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 space-y-8">
      
      <!-- Headline & Subtitle -->
      <div class="text-center space-y-4">
        <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">
          Free Online Bill & Trip Splitter
        </p>

        <div class="space-y-2">
          <h1 class="apple-hero-display text-[#1d1d1f] dark:text-white">
            Split Expenses Calculator Online
          </h1>
          <p class="text-[20px] sm:text-[28px] font-semibold text-[#86868b] dark:text-[#a1a1a6] tracking-tight">
            Calculate shared bills for friends, trips, and roommates in seconds
          </p>
        </div>

        <p class="text-[16px] sm:text-[17px] text-[#86868b] dark:text-[#a1a1a6] max-w-2xl mx-auto leading-relaxed">
          The simplest, fastest online bill split tool. No account required to test. Enter expenses, find who owes what, and settle with the minimum number of UPI or cash transfers.
        </p>
      </div>

      <!-- Calculator Card -->
      <div id="calculator" class="rounded-[24px] bg-white dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 p-6 sm:p-8 apple-product-shadow space-y-6">
        
        <!-- Members Input -->
        <div class="space-y-2">
          <label class="block text-[14px] font-semibold text-[#1d1d1f] dark:text-white">
            1. Group Members (comma separated):
          </label>
          <div class="flex flex-col sm:flex-row gap-3">
            <input
              type="text"
              id="trip-members"
              value="Amar, Akbar, Anthony"
              class="flex-1 px-4 py-2.5 rounded-full border border-black/15 dark:border-white/20 bg-transparent text-[15px] text-[#1d1d1f] dark:text-white focus:outline-none focus:border-[#0066cc]"
              placeholder="e.g. Amar, Akbar, Anthony"
            />
            <button
              type="button"
              id="btn-update-trip-members"
              class="px-5 py-2.5 rounded-full bg-[#0066cc] text-white text-[14px] font-normal hover:bg-[#0071e3] transition active:scale-95 cursor-pointer"
            >
              Update Members
            </button>
          </div>

          <!-- Animated Flatmate Avatar Strip -->
          <div class="flex flex-wrap items-center gap-3 pt-1">
            <span class="text-[12px] text-[#86868b]">Trip Members:</span>
            <div class="flex items-center gap-2">
              <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#f5f5f7] dark:bg-[#161617] border border-black/5 dark:border-white/10 text-[12px] font-medium">

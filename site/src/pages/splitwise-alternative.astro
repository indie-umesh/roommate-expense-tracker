---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const title = "Splitwise Alternative — Roommate";
const description = "Looking for the best free Splitwise alternative in 2026? Enjoy unlimited bill splits, zero wait timers, live Excel matrix views, and instant mobile login.";
const keywords = "splitwise alternative, free splitwise alternative, best splitwise alternative 2026, splitwise daily limit workaround, splitwise pro alternative, splitwise vs roommate";

const splitwiseFaq = [
  {
    question: "Why are so many users looking for a Splitwise alternative in 2026?",
    answer: "Splitwise instituted aggressive monetization: restricting free accounts to only 3 expenses per day, forcing users to wait through a 10-second countdown timer before saving, and paywalling standard features like receipt scanning and currency conversion behind a $39.99/year subscription."
  },
  {
    question: "How does Roommate compare to Splitwise for roommates and flatmates?",
    answer: "Roommate is built specifically for shared living. Unlike Splitwise, Roommate offers unlimited expense entries, zero daily caps, zero wait timers, a built-in Excel sheet matrix view, and instant login using your phone number and 6-digit PIN (no OTP or password hassle)."
  },
  {
    question: "Does Roommate have an expense limit like Splitwise's 3 per day?",
    answer: "No. You can add 5, 20, or 100 expenses every day completely free. There are never any artificial limits, countdown timers, or paywalls."
  },
  {
    question: "Can I view all expenses in a spreadsheet format in Roommate?",
    answer: "Yes! While Splitwise locks itemized exports behind Splitwise Pro, Roommate has a native 'Spreadsheet Matrix' tab that displays all expenses as rows, members as columns, and live net balance calculations, with 1-click client-side export to .xlsx and PDF."
  },
  {
    question: "How do I switch from Splitwise to Roommate?",
    answer: "Settling up in Splitwise and starting fresh in Roommate takes under 2 minutes. Open Roommate, create a flat group, copy the unique 4-character invite code, and send it to your roommates on WhatsApp. You're ready to log bills immediately."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  faqSchema={splitwiseFaq}
  breadcrumbs={[
    { name: "Home", url: "https://roommatesexpensemanager.com" },
    { name: "Splitwise Alternative", url: "https://roommatesexpensemanager.com/splitwise-alternative" }
  ]}
>
  <!-- Hero Section -->
  <section class="pt-16 pb-16 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-rose-950/60 border border-rose-800/60 text-xs font-semibold text-rose-300">
          ⚠️ Frustrated by the 3 Expenses/Day Paywall?
        </span>

        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
          The 100% Free <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-indigo-400">
            Splitwise Alternative
          </span>
          for Roommates
        </h1>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl mx-auto">
          No 3-expense daily caps. No 10-second countdown wait screens. No $39.99/yr subscriptions. Just lightning-fast bill splitting in &lt; 3 taps, live spreadsheet matrices, and instant settlements.
        </p>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="http://localhost:5173"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-extrabold text-sm sm:text-base shadow-xl shadow-indigo-600/30 transition active:scale-95 flex items-center justify-center gap-2"
          >
            <span>Switch to Roommate Free</span>
            <span aria-hidden="true">→</span>
          </a>

          <a
            href="#reasons"
            class="w-full sm:w-auto px-6 py-4 rounded-2xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700 font-semibold text-sm transition"
          >
            Why Roommates are Leaving Splitwise ↓
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Breakdown: Splitwise Limitations in 2026 -->
  <section id="reasons" class="py-16 bg-slate-900/40 border-y border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          What Happened to Splitwise?
        </h2>
        <p class="text-xs sm:text-sm text-slate-400">
          Once the gold standard of expense sharing, recent updates have turned Splitwise into a frustrating, ad-ridden experience.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-3xl bg-slate-950/80 border border-rose-900/30 space-y-3">
          <div class="text-2xl">🛑</div>
          <h3 class="text-base font-bold text-rose-400">The 3-Expense Daily Cap</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            On Splitwise free, once you add 3 expenses in a 24-hour period (e.g., breakfast, groceries, and an Uber), the app blocks you from logging further bills unless you pay for Splitwise Pro.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-slate-950/80 border border-amber-900/30 space-y-3">
          <div class="text-2xl">⏳</div>
          <h3 class="text-base font-bold text-amber-400">10-Second Wait Timers</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Free users are forced to stare at an intentional 10-second countdown timer before saving every transaction—designed solely to annoy you into buying a subscription.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-slate-950/80 border border-purple-900/30 space-y-3">
          <div class="text-2xl">💸</div>
          <h3 class="text-base font-bold text-purple-400">$39.99/Year Subscription</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Features that used to be free—charts, itemized reports, receipt storage—are locked behind a yearly paywall that makes no sense for college students and shared-flat bachelors.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Comparison Table -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs font-bold text-indigo-400 uppercase tracking-widest">Head to Head</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Splitwise vs. Roommate: Detailed Breakdown
        </h2>
      </div>

      <div class="max-w-5xl mx-auto">
        <ComparisonTable highlightCompetitor="splitwise" />
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-slate-900/30 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <FaqAccordion
        items={splitwiseFaq}
        title="Splitwise Alternative FAQ"
        subtitle="Common questions about switching from Splitwise to Roommate."
      />
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 border-t border-slate-800 text-center space-y-5">
    <h2 class="text-2xl sm:text-4xl font-extrabold text-white">Never Get Blocked by Splitwise Limits Again</h2>
    <p class="text-xs sm:text-sm text-slate-400 max-w-md mx-auto">Join thousands of roommates tracking expenses with zero daily caps and zero wait times.</p>
    <a
      href="http://localhost:5173"
      class="inline-flex items-center gap-2 px-8 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-sm shadow-xl transition active:scale-95"
    >
      <span>Open Roommate Free</span>
      <span>⚡</span>
    </a>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const title = "Splitwise Alternative — Roommate";
const description = "Looking for the best free Splitwise alternative in 2026? Enjoy unlimited bill splits, zero wait timers, live Excel matrix views, and instant mobile login.";
const keywords = "splitwise alternative, free splitwise alternative, best splitwise alternative 2026, splitwise daily limit workaround, splitwise pro alternative, splitwise vs roommate";

const splitwiseFaq = [
  {
    question: "Why are so many users looking for a Splitwise alternative in 2026?",
    answer: "Splitwise instituted aggressive monetization: restricting free accounts to only 3 expenses per day, forcing users to wait through a 10-second countdown timer before saving, and paywalling standard features like receipt scanning and currency conversion behind a $39.99/year subscription."
  },
  {
    question: "How does Roommate compare to Splitwise for roommates and flatmates?",
    answer: "Roommate is built specifically for shared living. Unlike Splitwise, Roommate offers unlimited expense entries, zero daily caps, zero wait timers, a built-in Excel sheet matrix view, and instant login using your phone number and 6-digit PIN (no OTP or password hassle)."
  },
  {
    question: "Does Roommate have an expense limit like Splitwise's 3 per day?",
    answer: "No. You can add 5, 20, or 100 expenses every day completely free. There are never any artificial limits, countdown timers, or paywalls."
  },
  {
    question: "Can I view all expenses in a spreadsheet format in Roommate?",
    answer: "Yes! While Splitwise locks itemized exports behind Splitwise Pro, Roommate has a native 'Spreadsheet Matrix' tab that displays all expenses as rows, members as columns, and live net balance calculations, with 1-click client-side export to .xlsx and PDF."
  },
  {
    question: "How do I switch from Splitwise to Roommate?",
    answer: "Settling up in Splitwise and starting fresh in Roommate takes under 2 minutes. Open Roommate, create a flat group, copy the unique 4-character invite code, and send it to your roommates on WhatsApp. You're ready to log bills immediately."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  faqSchema={splitwiseFaq}
  breadcrumbs={[
    { name: "Home", url: "https://roommatesexpensemanager.com" },
    { name: "Splitwise Alternative", url: "https://roommatesexpensemanager.com/splitwise-alternative" }
  ]}
>
  <!-- Hero Section (Apple Clean Canvas) -->
  <section class="pt-16 pb-16 bg-white dark:bg-black transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 text-center space-y-5">
      <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">
        The #1 Free Splitwise Alternative for Flatmates
      </p>

      <div class="space-y-2">
        <h1 class="apple-hero-display text-[#1d1d1f] dark:text-white">
          Best Free Splitwise Alternative
        </h1>
        <p class="text-[20px] sm:text-[28px] font-semibold text-[#86868b] dark:text-[#a1a1a6] tracking-tight">
          Zero daily limits. Zero wait timers. Live Excel matrix.
        </p>
      </div>

      <p class="text-[16px] sm:text-[17px] text-[#86868b] dark:text-[#a1a1a6] max-w-2xl mx-auto leading-relaxed">
        No 3-expense daily caps. No 10-second countdown wait screens. No $39.99/yr subscriptions. Just lightning-fast bill splitting in &le; 3 taps, live spreadsheet matrices, and instant settlements.
      </p>

      <div class="flex items-center justify-center gap-6 pt-2">
        <a
          href="http://localhost:5173"
          class="apple-btn-primary"
        >
          Switch to Roommate Free
        </a>

        <a
          href="#reasons"
          class="apple-btn-secondary"
        >
          <span>Why Roommates are Leaving Splitwise</span>
          <span aria-hidden="true">›</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Problem Breakdown: Splitwise Limitations in 2026 (Apple Parchment) -->
  <section id="reasons" class="py-20 bg-[#f5f5f7] dark:bg-[#161617] border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h2 class="apple-display-lg text-[#1d1d1f] dark:text-white">
          What Happened to Splitwise in 2026?
        </h2>
        <p class="text-[17px] text-[#86868b]">
          Once the standard of expense sharing, recent monetization paywalls have broken user trust.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-8 rounded-[24px] bg-white dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 space-y-3 apple-product-shadow">
          <div class="text-3xl">🛑</div>
          <h3 class="text-[18px] font-semibold text-[#1d1d1f] dark:text-white">The 3-Expense Daily Cap</h3>
          <p class="text-[14px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
            On Splitwise free, once you add 3 expenses in a 24-hour period (e.g. breakfast, groceries, and an Uber), the app blocks you from logging further bills unless you pay for Splitwise Pro.
          </p>
        </div>

        <div class="p-8 rounded-[24px] bg-white dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 space-y-3 apple-product-shadow">
          <div class="text-3xl">⏳</div>
          <h3 class="text-[18px] font-semibold text-[#1d1d1f] dark:text-white">10-Second Wait Timers</h3>
          <p class="text-[14px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
            Free users are forced to stare at an intentional 10-second countdown timer before saving every transaction—designed solely to annoy you into buying an expensive subscription.
          </p>
        </div>

        <div class="p-8 rounded-[24px] bg-white dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 space-y-3 apple-product-shadow">
          <div class="text-3xl">💸</div>
          <h3 class="text-[18px] font-semibold text-[#1d1d1f] dark:text-white">$39.99/Year Subscription</h3>
          <p class="text-[14px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
            Features that used to be free—charts, itemized reports, receipt storage—are locked behind a yearly paywall that makes no sense for college students and shared-flat bachelors.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Comparison Table (Apple Pure Canvas) -->
  <section class="py-20 bg-white dark:bg-black transition-colors duration-200 border-t border-black/5 dark:border-white/10">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">Head to Head</p>
        <h2 class="apple-display-lg text-[#1d1d1f] dark:text-white">
          Splitwise vs. Roommate: Detailed Breakdown
        </h2>
      </div>

      <div>
        <ComparisonTable highlightCompetitor="splitwise" />
      </div>
    </div>
  </section>

  <!-- FAQ Section (Apple Parchment) -->
  <section class="py-20 bg-[#f5f5f7] dark:bg-[#161617] border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6">
      <FaqAccordion
        items={splitwiseFaq}
        title="Splitwise Alternative FAQ"
        subtitle="Common questions about switching from Splitwise to Roommate."
      />
    </div>
  </section>

  <!-- CTA Section (Apple Pure Canvas) -->
  <section class="py-20 bg-white dark:bg-black border-t border-black/5 dark:border-white/10 text-center space-y-5 transition-colors duration-200">
    <h2 class="apple-display-lg text-[#1d1d1f] dark:text-white">
      Never Get Blocked by Splitwise Limits Again
    </h2>
    <p class="text-[17px] text-[#86868b] dark:text-[#a1a1a6] max-w-md mx-auto">
      Join thousands of roommates tracking expenses with zero daily caps and zero wait times.
    </p>
    <div class="pt-2 flex items-center justify-center">
      <a
        href="http://localhost:5173"
        class="apple-btn-primary"
      >
        <span>Start Tracking Free</span>
        <span aria-hidden="true">›</span>
      </a>
    </div>
  </section>
</BaseLayout>

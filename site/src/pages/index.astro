---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroDashboardSimulator from '../components/HeroDashboardSimulator.astro';
import InteractiveDebtSimplifier from '../components/InteractiveDebtSimplifier.astro';
import ExcelMatrixPreview from '../components/ExcelMatrixPreview.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { APP_URL } from '../config/site';

const title = "Roommate — Free Shared Expense Tracker";
const description = "The zero-friction roommate expense tracker. Log shared bills in under 3 taps, view live Excel matrices, and simplify debts with zero daily limits.";
const keywords = "roommate expense tracker, roommate expense tracker app, shared expense tracker app free, roommate expense tracker excel, roommate expense tracker google sheets, splitwise alternative, free bill split app";

const homeFaq = [
  {
    question: "What is Roommate Expense Tracker and how does it work?",
    answer: "Roommate is a lightning-fast web app and installable PWA designed specifically for flatmates and roommates. It lets you log rent, groceries, Wi-Fi, and utility bills in under 10 seconds. The app runs a real-time greedy debt simplification algorithm to reduce multiple complex debts into the minimum number of direct UPI/cash settlements, ensuring everyone pays exactly their fair share."
  },
  {
    question: "Is Roommate really 100% free with no daily limits like Splitwise?",
    answer: "Yes, completely free forever. Splitwise recently imposed a restrictive 3-expense per day limit on free accounts and added 10-second wait timers. Roommate has zero artificial limits, no wait timers, and no paid pro tier. You can log unlimited expenses across unlimited groups."
  },
  {
    question: "Why is Roommate better than a Google Sheets or Excel spreadsheet?",
    answer: "Google Sheets fails for shared flats not because of the math, but because of entry friction. Opening a spreadsheet on a mobile phone at a supermarket checkout, zooming into tiny cells, and typing amounts takes 45+ seconds, so roommates put it off and forget. Roommate takes ≤ 3 taps (under 10 seconds). Plus, it gives you a built-in Excel matrix view and 1-click .xlsx export anytime you want spreadsheet transparency."
  },
  {
    question: "How do we sign in without waiting for OTP SMS codes?",
    answer: "We designed Roommate to be 100% spam-proof and friction-free. You sign in with your 10-digit mobile number and a personal 6-digit security PIN. No waiting for SMS OTPs that get delayed or fail when telecom networks are busy."
  },
  {
    question: "How does Roommate solve roommates having different paydays?",
    answer: "Most roommates get paid on different dates (e.g. Anthony on the 1st, Akbar on the 5th, Amar on the 15th). Roommate maintains a real-time running net balance ledger so you can cover each other throughout the month without stressing. When month-end arrives, settling all dues takes under 5 minutes."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  faqSchema={homeFaq}
>
  <!-- 1. HERO PRODUCT TILE (Canvas: Pure White / Pure Black) -->
  <section class="pt-16 pb-20 bg-white dark:bg-black transition-colors duration-200 relative overflow-hidden">
    <!-- Ambient Hardware Glow -->
    <div class="apple-hero-glow"></div>

    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 text-center space-y-6 relative z-10 apple-reveal">
      
      <!-- Eyebrow / Tagline -->
      <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">
        Roommate Expense Tracker
      </p>

      <!-- Main Headline in Apple SF Pro Display -->
      <div class="space-y-2">
        <h1 class="apple-hero-display text-[#1d1d1f] dark:text-white">
          The Zero-Friction Shared Bill Tracker
        </h1>
        <p class="text-[20px] sm:text-[28px] font-semibold text-[#86868b] dark:text-[#a1a1a6] tracking-tight">
          Track in seconds. Settle at month-end in minutes.
        </p>
      </div>

      <!-- Lead paragraph -->
      <p class="text-[16px] sm:text-[17px] text-[#86868b] dark:text-[#a1a1a6] max-w-2xl mx-auto leading-relaxed">
        Tired of forgotten bills, broken spreadsheets, and Splitwise's 3-expense daily cap? Roommate gives flatmates instant bill logging, live Excel balance matrices, and zero daily limits. 100% free forever.
      </p>

      <!-- Apple Action Blue CTA Group -->
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 pt-2">
        <a
          href={APP_URL}
          class="apple-btn-primary"
        >
          Start Tracking Free
        </a>

        <a
          href="#comparison"
          class="apple-btn-secondary"
        >
          <span>Compare vs Splitwise</span>
          <span aria-hidden="true">›</span>
        </a>
      </div>

      <!-- Metric Badges in Apple Grid (Balanced Single-Line Rhythm & Baselines) -->
      <div class="pt-10 max-w-3xl mx-auto border-t border-black/8 dark:border-white/10">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-2 text-center">
          <div class="flex flex-col items-center">
            <span class="text-[22px] sm:text-[28px] font-semibold text-[#1d1d1f] dark:text-white tracking-tight whitespace-nowrap">
              ≤ 3 Taps
            </span>
            <span class="text-[13px] text-[#86868b] mt-1 whitespace-nowrap">
              Add bill in &lt;10s
            </span>
          </div>

          <div class="flex flex-col items-center">
            <span class="text-[22px] sm:text-[28px] font-semibold text-[#00966d] dark:text-[#00e599] tracking-tight whitespace-nowrap">
              100% Free
            </span>
            <span class="text-[13px] text-[#86868b] mt-1 whitespace-nowrap">
              No daily caps or timers
            </span>
          </div>

          <div class="flex flex-col items-center">
            <span class="text-[22px] sm:text-[28px] font-semibold text-[#1d1d1f] dark:text-white tracking-tight whitespace-nowrap">
              Zero OTP
            </span>
            <span class="text-[13px] text-[#86868b] mt-1 whitespace-nowrap">
              Mobile + 6-digit PIN
            </span>
          </div>

          <div class="flex flex-col items-center">
            <span class="text-[22px] sm:text-[28px] font-semibold text-[#1d1d1f] dark:text-white tracking-tight whitespace-nowrap">
              Excel Matrix
            </span>
            <span class="text-[13px] text-[#86868b] mt-1 whitespace-nowrap">
              1-Click XLSX export
            </span>
          </div>
        </div>
      </div>

      <!-- Real Product UI Simulator Resting On Surface With System Shadow -->
      <div class="pt-10">
        <HeroDashboardSimulator />
      </div>
    </div>
  </section>

  <!-- 2. DEBT SIMPLIFICATION SECTION (Parchment: #f5f5f7 / #161617) -->
  <section class="py-20 bg-[#f5f5f7] dark:bg-[#161617] border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6">
      <InteractiveDebtSimplifier />
    </div>
  </section>

  <!-- 3. VALUE PILLARS (Store Utility Cards Grid on Pure White / Pure Black) -->
  <section class="py-20 bg-white dark:bg-black transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h2 class="apple-display-lg text-[#1d1d1f] dark:text-white">
          Why Roommate Beats Every Other Shared Expense Tool
        </h2>
        <p class="text-[17px] text-[#86868b]">
          Engineered from real shared-flat experience. Here is why it feels effortless.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="p-6 rounded-[18px] bg-white dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 space-y-3">
          <div class="text-[28px]">⚡</div>
          <h3 class="text-[17px] font-semibold text-[#1d1d1f] dark:text-white">3-Tap Mobile Entry (&lt;10s)</h3>
          <p class="text-[14px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
            Most expense trackers fail because logging a ₹120 milk packet feels like filing paperwork. With Roommate, enter the amount, select who shared it, and tap save. Done at the counter in under 10 seconds.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="p-6 rounded-[18px] bg-white dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 space-y-3">
          <div class="text-[28px]">📊</div>
          <h3 class="text-[17px] font-semibold text-[#1d1d1f] dark:text-white">Built-in Excel Sheet Matrix</h3>
          <p class="text-[14px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
            Want to verify the math? Toggle the spreadsheet tab to view every bill as a row, each roommate's share as a column, and the exact net balance row. Export directly to .xlsx client-side anytime.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="p-6 rounded-[18px] bg-white dark:bg-[#1d1d1f] border border-black/8 dark:border-white/10 space-y-3">
          <div class="text-[28px]">🔒</div>
          <h3 class="text-[17px] font-semibold text-[#1d1d1f] dark:text-white">Zero OTP Friction (Mobile + PIN)</h3>
          <p class="text-[14px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
            No waiting 3 minutes for an SMS OTP that gets delayed. Your phone number is your identifier, and a secure 6-digit numeric PIN is your instant key. Quick, seamless, and spam-free.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. LIVE EXCEL MATRIX SPOTLIGHT (Parchment: #f5f5f7 / #161617) -->
  <section class="py-20 bg-[#f5f5f7] dark:bg-[#161617] border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <p class="text-[14px] font-semibold text-[#00966d] dark:text-[#00e599]">Spreadsheet Transparency</p>
        <h2 class="apple-display-lg text-[#1d1d1f] dark:text-white">
          The Power of an Excel Sheet Without Broken Formulas
        </h2>
        <p class="text-[17px] text-[#86868b]">
          Spreadsheets break when someone accidentally deletes a cell formula or changes a column. Roommate provides spreadsheet clarity backed by an unbreakable database.
        </p>
      </div>

      <div>
        <ExcelMatrixPreview />
      </div>
    </div>
  </section>

  <!-- 5. COMPETITOR COMPARISON (Pure White / Pure Black) -->
  <section id="comparison" class="py-20 bg-white dark:bg-black transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <p class="text-[14px] font-semibold text-[#00966d] dark:text-[#00e599]">Unbiased Comparison</p>
        <h2 class="apple-display-lg text-[#1d1d1f] dark:text-white">
          Roommate vs. Splitwise vs. Google Sheets
        </h2>
        <p class="text-[17px] text-[#86868b]">
          See why thousands of flatmates and bachelors are ditching restrictive paid apps and clunky spreadsheets for Roommate.
        </p>
      </div>

      <div>
        <ComparisonTable />
      </div>

      <div class="text-center pt-2">
        <a
          href="/splitwise-alternative"
          class="apple-btn-secondary text-[15px]"
        >
          <span>Read our full Splitwise Alternative Analysis</span>
          <span aria-hidden="true">›</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 6. THE ORIGIN STORY: AMAR, AKBAR, AND ANTHONY (Parchment: #f5f5f7 / #161617) -->
  <section class="py-20 bg-[#f5f5f7] dark:bg-[#161617] border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[760px] mx-auto px-4 sm:px-6 space-y-6">
      <div class="space-y-1">
        <p class="text-[13px] font-semibold uppercase tracking-wider text-[#00966d] dark:text-[#00e599]">The Origin Story</p>
        <h2 class="apple-display-lg text-[#1d1d1f] dark:text-white">
          Built for Amar, Akbar, and Anthony.
        </h2>
      </div>

      <div class="space-y-4 text-[17px] text-[#1d1d1f] dark:text-[#f5f5f7] leading-relaxed">
        <p>
          In our shared flat, we ran into a classic problem: <strong>our paydays fall on completely different dates</strong>. Anthony gets paid on the <strong>1st</strong>, Akbar on the <strong>5th</strong>, and Amar on the <strong>15th</strong>.
        </p>
        <p>
          Because of that, whoever had cash on hand covered rent, groceries, and bills for the first two weeks, and we reconciled later. We tried tracking this in a Google Sheet for months. <strong>It failed miserably.</strong>
        </p>
        <p>
          Expenses weren't logged when they happened because opening Google Sheets on a phone was painful. By month-end, reconstructing ₹20,000 of mixed expenses took 3 hours of awkward discussions and receipts digging.
        </p>
        <p class="font-medium text-[#1d1d1f] dark:text-white">
          The root cause was entry friction, not the math. So we engineered Roommate with one ironclad rule: adding any bill must take under 3 taps and 10 seconds. Now, our month-end settlement takes under 5 minutes.
        </p>
      </div>

      <div class="pt-4 flex flex-wrap items-center gap-3 sm:gap-6">
        <a
          href={APP_URL}
          class="apple-btn-primary"
        >
          Try Roommate Free
        </a>
        <a
          href="/blog/how-to-manage-different-paydays-with-roommates"
          class="apple-btn-secondary"
        >
          <span>Read Payday Guide</span>
          <span aria-hidden="true">›</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 7. FAQ ACCORDION (Pure White / Pure Black) -->
  <section class="py-20 bg-white dark:bg-black transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6">
      <FaqAccordion items={homeFaq} />
    </div>
  </section>

  <!-- 8. FINAL CTA TILE (Parchment: #f5f5f7 / #161617) -->
  <section class="py-20 bg-[#f5f5f7] dark:bg-[#161617] border-t border-black/5 dark:border-white/10 text-center transition-colors duration-200">
    <div class="max-w-[680px] mx-auto px-4 sm:px-6 space-y-4">
      <h2 class="apple-display-lg text-[#1d1d1f] dark:text-white">
        Ready to Settle Flat Bills in &lt; 5 Minutes?
      </h2>
      <p class="text-[17px] text-[#86868b] leading-relaxed">
        No credit card, no app store download required, no daily expense caps. Works instantly on any mobile or desktop browser.
      </p>
      <div class="pt-3">
        <a
          href={APP_URL}
          class="apple-btn-primary"
        >
          Launch Roommate App Free
        </a>
      </div>
      <p class="text-[12px] text-[#86868b] pt-2">100% Free Forever · Secure Mobile PIN · Instant Group Invite</p>
    </div>
  </section>
</BaseLayout>

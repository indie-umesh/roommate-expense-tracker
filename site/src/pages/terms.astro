---
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_URL } from '../config/site';

const title = "Terms of Service — Roommate";
const description = "Terms and conditions for using Roommate, the zero-friction shared expense tracker.";
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl="https://roommatesexpensemanager.com/terms"
  breadcrumbs={[
    { name: "Home", url: "https://roommatesexpensemanager.com" },
    { name: "Terms of Service", url: "https://roommatesexpensemanager.com/terms" }
  ]}
>
  <main class="py-16 bg-white dark:bg-black transition-colors duration-200">
    <div class="max-w-[760px] mx-auto px-4 sm:px-6 space-y-10 text-[#1d1d1f] dark:text-[#f5f5f7]">
      <div class="space-y-3 border-b border-black/10 dark:border-white/10 pb-8">
        <p class="text-xs font-semibold tracking-wider uppercase text-[#00966d] dark:text-[#00e599]">Legal Agreement</p>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Terms of Service</h1>
        <p class="text-xs text-[#86868b]">Last Updated: November 24, 2026</p>
      </div>

      <section class="space-y-4">
        <h2 class="text-xl font-semibold">1. Acceptance of Terms</h2>
        <p class="text-sm leading-relaxed text-[#515154] dark:text-[#a1a1a6]">
          By accessing or using Roommate (including our website and web application), you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use the service.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl font-semibold">2. Service Description</h2>
        <p class="text-sm leading-relaxed text-[#515154] dark:text-[#a1a1a6]">
          Roommate provides an online collaborative ledger and debt-simplification tool for roommates, friends, and travel groups. The service is provided as a productivity and calculation aid. Roommate is not a bank, escrow service, money transmitter, or licensed financial advisor.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl font-semibold">3. Free Usage & Availability</h2>
        <p class="text-sm leading-relaxed text-[#515154] dark:text-[#a1a1a6]">
          Roommate is provided 100% free with zero daily caps or subscription gates. While we strive for 99.9% uptime and reliable performance, the service is provided on an "as is" and "as available" basis without warranties of any kind.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl font-semibold">4. Account Responsibility</h2>
        <p class="text-sm leading-relaxed text-[#515154] dark:text-[#a1a1a6]">
          You are responsible for maintaining the confidentiality of your mobile login and PIN. You agree to notify us immediately of any unauthorized use of your account.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl font-semibold">5. Limitation of Liability</h2>
        <p class="text-sm leading-relaxed text-[#515154] dark:text-[#a1a1a6]">
          To the maximum extent permitted by applicable law, Roommate and its contributors shall not be liable for any indirect, incidental, or consequential damages resulting from calculation discrepancies, offline synchronization errors, or payment disputes between flatmates.
        </p>
      </section>
    </div>
  </main>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExcelMatrixPreview from '../components/ExcelMatrixPreview.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const title = "Free Roommate Expense Tracker Template (Web, Excel & Google Sheets)";
const description = "Download our free roommate expense tracker template or use our interactive web app to split rent, groceries, and flat bills with zero friction and automated debt simplification.";
const keywords = "roommate expense tracker template, free flat expense template, bill split template, roommate budget spreadsheet, shared living expense tracker template";

const templateFaq = [
  {
    question: "What is included in the Roommate Expense Tracker Template?",
    answer: "The template includes full support for date tracking, itemized expense details, payer tagging, individual participant share columns, automated net balance calculations, and debt simplification summaries."
  },
  {
    question: "How do I use this template with my roommates?",
    answer: "You can either use our instant web app (which requires zero setup and no spreadsheet maintenance) or export your group's live data to an .xlsx workbook anytime."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  faqSchema={templateFaq}
  breadcrumbs={[
    { name: "Home", url: "https://roommatesexpensemanager.com" },
    { name: "Expense Template", url: "https://roommatesexpensemanager.com/roommate-expense-tracker-template" }
  ]}
>
  <section class="pt-16 pb-12 max-w-4xl mx-auto px-4 text-center space-y-6">
    <span class="px-3.5 py-1.5 rounded-full bg-indigo-950/70 border border-indigo-800/60 text-xs font-semibold text-indigo-300">
      Ready-to-Use Bill Split Template
    </span>

    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
      Free Roommate Expense Tracker <br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-emerald-400">
        Template & Interactive App
      </span>
    </h1>

    <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Everything you need to track rent, groceries, milk, Wi-Fi, and utilities fairly between flatmates without messy manual math or awkward conversations.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
      <a href="http://localhost:5173" class="px-8 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-extrabold text-sm shadow-xl transition">
        Use Interactive Web App (Recommended) →
      </a>
      <a href="/roommate-expense-tracker-excel" class="px-6 py-3.5 rounded-2xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700 font-semibold text-sm transition">
        View Excel Matrix
      </a>
    </div>
  </section>

  <section class="py-12 max-w-5xl mx-auto px-4">
    <ExcelMatrixPreview />
  </section>

  <section class="py-12 max-w-5xl mx-auto px-4">
    <FaqAccordion items={templateFaq} title="Roommate Template FAQ" />
  </section>
</BaseLayout>

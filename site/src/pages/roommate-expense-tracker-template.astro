---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExcelMatrixPreview from '../components/ExcelMatrixPreview.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const title = "Expense Tracker Template — Roommate";
const description = "Download our free roommate expense tracker template for Excel and Google Sheets, or use our interactive web app to split flat rent and bills automatically.";
const keywords = "roommate expense tracker template, free flat expense template, bill split template, roommate budget spreadsheet, shared living expense tracker template";

const templateFaq = [
  {
    question: "What is included in the Roommate Expense Tracker Template?",
    answer: "The template includes full support for date tracking, itemized expense details, payer tagging, individual participant share columns, automated net balance calculations, and debt simplification summaries."
  },
  {
    question: "How do I use this template with my roommates?",
    answer: "You can either use our instant web app (which requires zero setup and no spreadsheet maintenance) or export your group's live data to an .xlsx workbook anytime."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  faqSchema={templateFaq}
  breadcrumbs={[
    { name: "Home", url: "https://roommatesexpensemanager.com" },
    { name: "Expense Template", url: "https://roommatesexpensemanager.com/roommate-expense-tracker-template" }
  ]}
>
  <!-- Hero Section (Apple Clean Canvas) -->
  <section class="pt-16 pb-16 bg-white dark:bg-black transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 text-center space-y-5">
      <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">
        Ready-to-Use Bill Split Template
      </p>

      <div class="space-y-2">
        <h1 class="apple-hero-display text-[#1d1d1f] dark:text-white">
          Free Expense Tracker Template
        </h1>
        <p class="text-[20px] sm:text-[28px] font-semibold text-[#86868b] dark:text-[#a1a1a6] tracking-tight">
          Download clean spreadsheets or use our instant web app
        </p>
      </div>

      <p class="text-[16px] sm:text-[17px] text-[#86868b] dark:text-[#a1a1a6] max-w-2xl mx-auto leading-relaxed">
        Everything you need to track rent, groceries, milk, Wi-Fi, and utilities fairly between flatmates without messy manual math or awkward conversations.
      </p>

      <div class="flex items-center justify-center gap-6 pt-2">
        <a
          href="http://localhost:5173"
          class="apple-btn-primary"
        >
          Use Interactive Web App
        </a>

        <a
          href="/roommate-expense-tracker-excel"
          class="apple-btn-secondary"
        >
          <span>View Excel Matrix</span>
          <span aria-hidden="true">›</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Live Matrix Showcase (Apple Parchment) -->
  <section class="py-20 bg-[#f5f5f7] dark:bg-[#161617] border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6">
      <ExcelMatrixPreview />
    </div>
  </section>

  <!-- FAQ Section (Apple Pure Canvas) -->
  <section class="py-20 bg-white dark:bg-black border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6">
      <FaqAccordion
        items={templateFaq}
        title="Roommate Template FAQ"
        subtitle="Frequently asked questions about downloading and using expense templates."
      />
    </div>
  </section>
</BaseLayout>

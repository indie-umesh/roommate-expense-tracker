---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const title = "Shared Expense Tracker App Free — Zero Limits, No Ads, Instant Web App";
const description = "Looking for a shared expense tracker app that is 100% free forever? Roommate lets flatmates, bachelors, and couples split rent, bills, and groceries with zero daily limits and zero ads.";
const keywords = "shared expense tracker app free, shared expense tracker app, shared expense tracker, free bill split app, roommate expense tracker free";

const freeFaq = [
  {
    question: "Is Roommate really 100% free with no hidden charges?",
    answer: "Yes, completely free. There are no subscriptions, no premium locked tiers, no ads, and no limits on how many expenses or groups you can create."
  },
  {
    question: "How is Roommate funded if it's completely free?",
    answer: "Roommate was built by full-stack engineers for their own shared room to solve their real-world expense problems. It runs on lightweight, modern serverless infrastructure with minimal operational cost, allowing us to keep it free forever without needing to monetize users."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  faqSchema={freeFaq}
  breadcrumbs={[
    { name: "Home", url: "https://roommatesexpensemanager.com" },
    { name: "Free Shared Expense Tracker", url: "https://roommatesexpensemanager.com/shared-expense-tracker-app-free" }
  ]}
>
  <section class="pt-16 pb-12 max-w-4xl mx-auto px-4 text-center space-y-6">
    <span class="px-3.5 py-1.5 rounded-full bg-emerald-950/70 border border-emerald-800/60 text-xs font-semibold text-emerald-300">
      100% Free Forever • Zero Hidden Fees
    </span>

    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
      The Best Shared Expense Tracker <br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-indigo-400">
        That is Actually 100% Free
      </span>
    </h1>

    <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
      No 3-expense/day limits. No 10-second wait timers. No banner ads. Just the fastest way for roommates and flatmates to track shared expenses and settle up in under 5 minutes.
    </p>

    <div class="pt-2">
      <a href="http://localhost:5173" class="px-8 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-sm shadow-xl transition">
        Start Using Free Now →
      </a>
    </div>
  </section>

  <section class="py-12 max-w-5xl mx-auto px-4">
    <ComparisonTable />
  </section>

  <section class="py-12 max-w-5xl mx-auto px-4">
    <FaqAccordion items={freeFaq} title="Free Shared Expense Tracker FAQ" />
  </section>
</BaseLayout>

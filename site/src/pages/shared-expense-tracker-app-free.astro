---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const title = "Shared Expense Tracker Free — Roommate";
const description = "100% free shared expense tracker app for flatmates, bachelors, and couples. Split rent, groceries, and utilities with zero daily caps and no SMS OTP delays.";
const keywords = "shared expense tracker app free, shared expense tracker app, shared expense tracker, free bill split app, roommate expense tracker free";

const freeFaq = [
  {
    question: "Is Roommate really 100% free with no hidden charges?",
    answer: "Yes, completely free. There are no subscriptions, no premium locked tiers, and no limits on how many expenses or groups you can create."
  },
  {
    question: "How is Roommate funded if it's completely free?",
    answer: "Roommate was built by full-stack engineers for their own shared room to solve their real-world expense problems. It runs on lightweight, modern serverless infrastructure with minimal operational cost, allowing us to keep it free forever without needing to monetize users."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  faqSchema={freeFaq}
  breadcrumbs={[
    { name: "Home", url: "https://roommatesexpensemanager.com" },
    { name: "Free Shared Expense Tracker", url: "https://roommatesexpensemanager.com/shared-expense-tracker-app-free" }
  ]}
>
  <!-- Hero Section (Apple Clean Canvas) -->
  <section class="pt-16 pb-16 bg-white dark:bg-black transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 text-center space-y-5">
      <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">
        100% Free Forever • Zero Hidden Fees
      </p>

      <div class="space-y-2">
        <h1 class="apple-hero-display text-[#1d1d1f] dark:text-white">
          Free Shared Expense Tracker
        </h1>
        <p class="text-[20px] sm:text-[28px] font-semibold text-[#86868b] dark:text-[#a1a1a6] tracking-tight">
          Unlimited bills, live Excel matrix, and instant settlement
        </p>
      </div>

      <p class="text-[16px] sm:text-[17px] text-[#86868b] dark:text-[#a1a1a6] max-w-2xl mx-auto leading-relaxed">
        No 3-expense/day limits. No 10-second wait timers. No artificial caps. Just the fastest way for roommates and flatmates to track shared expenses and settle up in under 5 minutes.
      </p>

      <div class="flex items-center justify-center gap-6 pt-2">
        <a
          href="http://localhost:5173"
          class="apple-btn-primary"
        >
          Start Using Free Now
        </a>
      </div>
    </div>
  </section>

  <!-- Comparison Section (Apple Parchment) -->
  <section class="py-20 bg-[#f5f5f7] dark:bg-[#161617] border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">Feature Comparison</p>
        <h2 class="apple-display-lg text-[#1d1d1f] dark:text-white">
          Compare With Other Apps
        </h2>
      </div>

      <div>
        <ComparisonTable />
      </div>
    </div>
  </section>

  <!-- FAQ Section (Apple Pure Canvas) -->
  <section class="py-20 bg-white dark:bg-black border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6">
      <FaqAccordion
        items={freeFaq}
        title="Free Shared Expense Tracker FAQ"
        subtitle="Common questions about our 100% free expense tracker."
      />
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const title = "Tricount Alternative — Roommate";
const description = "Looking for a modern Tricount alternative? Log flat bills in under 10 seconds, view live Excel matrices, and settle via direct UPI with zero daily limits.";
const keywords = "tricount alternative, best tricount alternative, free bill split app, shared expense tracker, split bills with roommates";

const tricountFaq = [
  {
    question: "Why look for an alternative to Tricount?",
    answer: "Tricount was designed primarily for one-off vacation trips. For permanent flats and ongoing roommate expenses across months, its lack of monthly settlement checkpoints, missing Excel-style ledger views, and ad-supported interface make ongoing accounting cumbersome."
  },
  {
    question: "How does Roommate handle ongoing month-to-month flat expenses?",
    answer: "Roommate is engineered specifically for monthly room expenses. It maintains clean checkpoints/settlement records without deleting history, supports payday staggering, and simplifies debts to minimal direct UPI transfers."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  faqSchema={tricountFaq}
  breadcrumbs={[
    { name: "Home", url: "https://roommatesexpensemanager.com" },
    { name: "Tricount Alternative", url: "https://roommatesexpensemanager.com/tricount-alternative" }
  ]}
>
  <!-- Hero Section (Apple Clean Canvas) -->
  <section class="pt-16 pb-16 bg-white dark:bg-black transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 text-center space-y-5">
      <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">
        The Better Tool for Flatmates
      </p>

      <div class="space-y-2">
        <h1 class="apple-hero-display text-[#1d1d1f] dark:text-white">
          The Modern Tricount Alternative
        </h1>
        <p class="text-[20px] sm:text-[28px] font-semibold text-[#86868b] dark:text-[#a1a1a6] tracking-tight">
          Built specifically for ongoing monthly shared living
        </p>
      </div>

      <p class="text-[16px] sm:text-[17px] text-[#86868b] dark:text-[#a1a1a6] max-w-2xl mx-auto leading-relaxed">
        Tricount is built for weekend trips; Roommate is built for monthly shared living. Add expenses in &lt;10s, view full spreadsheet matrices, and settle in 5 minutes.
      </p>

      <div class="flex items-center justify-center gap-6 pt-2">
        <a
          href="http://localhost:5173"
          class="apple-btn-primary"
        >
          Launch Roommate Free
        </a>
      </div>
    </div>
  </section>

  <!-- Comparison Section (Apple Parchment) -->
  <section class="py-20 bg-[#f5f5f7] dark:bg-[#161617] border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">Head to Head</p>
        <h2 class="apple-display-lg text-[#1d1d1f] dark:text-white">
          Tricount vs. Roommate
        </h2>
      </div>

      <div>
        <ComparisonTable highlightCompetitor="tricount" />
      </div>
    </div>
  </section>

  <!-- FAQ Section (Apple Pure Canvas) -->
  <section class="py-20 bg-white dark:bg-black border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6">
      <FaqAccordion
        items={tricountFaq}
        title="Tricount Alternative FAQ"
        subtitle="Why roommates choose Roommate over Tricount."
      />
    </div>
  </section>
</BaseLayout>

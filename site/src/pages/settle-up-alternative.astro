---
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_URL } from '../config/site';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const title = "Settle Up Alternative — Roommate";
const description = "Switch to the cleanest Settle Up alternative. 3-tap mobile expense logging, live Excel sheet balance matrices, zero bloat, and 100% free forever.";
const keywords = "settle up alternative, best settle up alternative, free expense split app, roommate expense tracker, flat bill splitter";

const settleUpFaq = [
  {
    question: "Why switch from Settle Up to Roommate?",
    answer: "Settle Up has become cluttered with popups, subscription up-sells, and heavy menus. Roommate is laser-focused on one design goal: adding an expense in under 3 taps (<10 seconds) with zero daily limits."
  },
  {
    question: "Does Roommate require an app store download?",
    answer: "No! Roommate is a progressive web app (PWA). It works on any device (Android, iPhone, Mac, Windows) instantly through your browser, and can be installed to your home screen with 0 MB storage wasted."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  faqSchema={settleUpFaq}
  breadcrumbs={[
    { name: "Home", url: "https://roommatesexpensemanager.com" },
    { name: "Settle Up Alternative", url: "https://roommatesexpensemanager.com/settle-up-alternative" }
  ]}
>
  <!-- Hero Section (Apple Clean Canvas) -->
  <section class="pt-16 pb-16 bg-white dark:bg-black transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 text-center space-y-5">
      <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">
        Zero Limits • Zero Bloat
      </p>

      <div class="space-y-2">
        <h1 class="apple-hero-display text-[#1d1d1f] dark:text-white">
          Clean, Fast Settle Up Alternative
        </h1>
        <p class="text-[20px] sm:text-[28px] font-semibold text-[#86868b] dark:text-[#a1a1a6] tracking-tight">
          3-tap expense entry with instant debt simplification
        </p>
      </div>

      <p class="text-[16px] sm:text-[17px] text-[#86868b] dark:text-[#a1a1a6] max-w-2xl mx-auto leading-relaxed">
        No subscription popups, no hidden paywalls, and no multi-screen setup. Fast mobile PIN login and instant debt simplification for roommates.
      </p>

      <div class="flex items-center justify-center gap-6 pt-2">
        <a
          href={APP_URL}
          class="apple-btn-primary"
        >
          Switch to Roommate Free
        </a>
      </div>
    </div>
  </section>

  <!-- Comparison Section (Apple Parchment) -->
  <section class="py-20 bg-[#f5f5f7] dark:bg-[#161617] border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <p class="text-[14px] sm:text-[17px] font-semibold text-[#86868b] tracking-tight">Head to Head</p>
        <h2 class="apple-display-lg text-[#1d1d1f] dark:text-white">
          Settle Up vs. Roommate
        </h2>
      </div>

      <div>
        <ComparisonTable />
      </div>
    </div>
  </section>

  <!-- FAQ Section (Apple Pure Canvas) -->
  <section class="py-20 bg-white dark:bg-black border-t border-black/5 dark:border-white/10 transition-colors duration-200">
    <div class="max-w-[1024px] mx-auto px-4 sm:px-6">
      <FaqAccordion
        items={settleUpFaq}
        title="Settle Up Alternative FAQ"
        subtitle="Frequently asked questions about switching to Roommate."
      />
    </div>
  </section>
</BaseLayout>
